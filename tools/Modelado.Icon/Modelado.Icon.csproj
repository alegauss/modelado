<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the app icon (MOD7) and writes src\Modelado.App\Modelado.ico. Run it again after a
       change to the mark or to Brand's icon colours; Program.cs has the command. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Modelado.Icon</RootNamespace>
    <!-- Top-level statements: the generated Program has no XML documentation to give. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brand's colours, and SkiaSharp to draw with, which Imaging already ships. -->
    <ProjectReference Include="..\..\src\Modelado.Imaging\Modelado.Imaging.csproj" />
  </ItemGroup>

</Project>
