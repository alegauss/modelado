    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Modelado.Cli</RootNamespace>
    <AssemblyName>modelado-cli</AssemblyName>
    <!-- Top-level statements: the generated Program has no XML documentation to give. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modelado.Inference\Modelado.Inference.csproj" />
    <!-- MOD65: cloud image-to-3d, over the window's key store, budgets and ledger. -->
    <ProjectReference Include="..\..\src\Modelado.Cloud\Modelado.Cloud.csproj" />
  </ItemGroup>

</Project>
