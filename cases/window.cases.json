{
  // MOD8: the first cases, read through the accessibility tree. Every later UI task adds its own.
  // Paths are relative to winwright.json's folder, where the app is started. --provider cpu keeps
  // every desk the same; none of these needs a model, so none needs .cache\models.

  "fixtures": [
    {
      "name": "the window a default installation opens",
      "arguments": ["--provider", "cpu"],
      "shareable": true
    },
    {
      "name": "a window opened on the photo fixture",
      "arguments": ["--open", "cases/fixtures/photo.png", "--provider", "cpu"],
      "shareable": true
    },
    {
      // Not lent: its case edits the model.
      "name": "a window on the cube fixture, to edit",
      "arguments": ["--open", "cases/fixtures/cube.obj", "--provider", "cpu"],
      "shareable": false
    },
    {
      // Not lent: its case opens About and closes it.
      "name": "a window to open About in",
      "arguments": ["--provider", "cpu"],
      "shareable": false
    },
    {
      "name": "a window asked to open a model that is not there",
      "arguments": ["--open", "cases/fixtures/missing.obj", "--provider", "cpu"],
      "shareable": true
    },
    {
      // MOD11: downloads from the fixture server CasesRun starts (tests/Modelado.Cases/FixtureServer.cs),
      // into a models folder staged empty. The stand-in is sent at 40 KB/s, so it never finishes here.
      "name": "a window downloading from the fixture server",
      "files": ["cases/fixtures/notes.txt"],
      "arguments": ["--models", "{files}/models", "--manifest", "http://127.0.0.1:47631/files/manifest.json", "--provider", "cpu"],
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD10: not lent, since files are dropped on it.
      "name": "an empty window to drop files on",
      "arguments": ["--provider", "cpu"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a default installation puts a window named Modelado on the desk",
      "catches": "an app that builds its window and then shows something else, or nothing at all, which every in-process test would pass",
      "filed": "MOD8",
      "tags": ["smoke", "window"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "Modelado$",
          "named": "the title bar ends in the app's name"
        }
      ]
    },

    {
      "name": "the toolbar offers Open on the empty window and keeps what needs a model off",
      "catches": "a toolbar whose Save as, Undo or turns can be pressed with nothing open, or whose Open cannot",
      "filed": "MOD5",
      "tags": ["smoke", "toolbar"],
      "fixture": "the window a default installation opens",
      "steps": [
        { "locator": "Button#ToolbarOpen", "act": "read", "reads": "name", "expect": "Open", "named": "the toolbar names its Open button" },
        { "locator": "Button#ToolbarOpen", "act": "read", "reads": "enabled", "expect": "enabled", "named": "and it can be pressed" },
        { "locator": "Button#ToolbarSaveAs", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "Save as waits for a model" },
        { "locator": "Button#UndoButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and so does Undo" },
        { "locator": "Button#RotateXButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and so do the turns" },
        { "locator": "Button#ResetViewButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and the front view" }
      ]
    },

    {
      "name": "the status bar names the provider and holds no run on an empty window",
      "catches": "a provider chip stuck on its placeholder, or a job or last-run chip left showing with nothing run",
      "filed": "MOD9",
      "tags": ["smoke", "status-bar", "provider"],
      "fixture": "the window a default installation opens",
      "steps": [
        { "locator": "Text#ProviderStatus", "act": "read", "reads": "name", "expect": "CPU", "named": "--provider cpu shows as CPU" },
        { "locator": "Text#JobChip", "act": "read", "absent": true, "named": "no run in progress" },
        { "locator": "Text#DownloadChip", "act": "read", "absent": true, "named": "no download in progress" },
        { "locator": "Text#LastRun", "act": "read", "absent": true, "named": "and nothing run yet" },
        { "locator": "Button#AboutButton", "act": "read", "reads": "name", "expect": "About and models", "named": "About sits in the status bar" }
      ]
    },

    {
      "name": "a default installation opens on the drop zone, with the formats and a way to pick a file",
      "catches": "a first screen with nothing on it to open a file with, or an operations panel offering runs with nothing open",
      "filed": "MOD10",
      "tags": ["smoke", "open"],
      "fixture": "the window a default installation opens",
      "steps": [
        { "locator": "Text#DropTitle", "act": "read", "reads": "name", "expect": "Drop a photo or a 3D model here", "named": "the drop zone says what it takes" },
        { "locator": "Text#DropFormats", "act": "read", "reads": "name", "matches": "^Photos: PNG, .*WEBP.*\\n3D models: GLB, OBJ, PLY, STL$", "named": "and lists the formats" },
        { "locator": "Button#OpenButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "Open can be pressed" },
        { "locator": "Button#ObjectButton", "act": "read", "absent": true, "named": "and the operations panel waits for a file" }
      ]
    },

    {
      "name": "a file that is neither a photo nor a model is refused on the drop zone, then a photo and a model switch cleanly",
      "catches": "a drop zone that accepts a drop and opens nothing, a refusal raised as a dialog, or a model that leaves the photo's operations on",
      "filed": "MOD10",
      "tags": ["open", "drop"],
      "fixture": "an empty window to drop files on",
      "steps": [
        { "locator": "Button#OpenButton", "act": "drop file", "with": "cases/fixtures/notes.txt", "named": "a text file is dropped on the drop zone" },
        { "locator": "Text#OpenError", "act": "read", "reads": "name", "expect": "notes.txt is not a photo or a 3D model Modelado can open.", "named": "the drop zone says why" },
        { "locator": "Button#OpenButton", "act": "drop file", "with": "cases/fixtures/photo.png", "named": "a photo is dropped" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "photo.png · 64 × 48", "named": "it opens" },
        { "locator": "Text#OpenError", "act": "read", "absent": true, "named": "and the refusal is gone with the drop zone" },
        { "locator": "Button#ObjectButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "the operations panel has appeared" },
        { "locator": "Image#ViewImage", "act": "drop file", "with": "cases/fixtures/cube.obj", "named": "a model is dropped on the photo" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "cube.obj", "named": "it replaces the photo" },
        { "locator": "Text#MeshText", "act": "read", "reads": "name", "expect": "8 vertices · 12 triangles", "named": "with its counts" },
        { "locator": "Button#ObjectButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and the photo's operations are off" },
        { "locator": "Image#ViewImage", "act": "drop file", "with": "cases/fixtures/notes.txt", "named": "the text file is dropped on the model" },
        { "locator": "Text#ViewerOpenError", "act": "read", "reads": "name", "expect": "notes.txt is not a photo or a 3D model Modelado can open.", "named": "it says why over the model" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "cube.obj", "named": "and the model stays" }
      ]
    },

    {
      "name": "About opens and closes during a download whose chip keeps going",
      "catches": "an About that hides a running download, stops it, or takes the status bar with it",
      "filed": "MOD11",
      "tags": ["about", "download", "status-bar"],
      "fixture": "a window downloading from the fixture server",
      "steps": [
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About and models is pressed" },
        { "locator": "Button#AboutDownloadAll", "act": "invoke", "named": "Download everything is pressed" },
        { "locator": "Window[class=\"#32770\"] > Button#1", "act": "invoke", "named": "the download is agreed to" },
        { "locator": "Text#DownloadChip", "act": "read", "reads": "name", "matches": "^Downloading models: \\S+: \\d+ MB of \\d+ MB", "named": "the status bar shows the download" },
        { "locator": "Text#AboutDownloadStatus", "act": "read", "reads": "name", "matches": "^\\S+: \\d+ MB of \\d+ MB", "named": "and so does About" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "Back is pressed" },
        { "locator": "Text#AboutVersion", "act": "read", "absent": true, "named": "About has closed" },
        { "locator": "Text#DownloadChip", "act": "read", "reads": "name", "matches": "^Downloading models: \\S+: \\d+ MB of \\d+ MB", "named": "the download is still going" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About is opened again" },
        { "locator": "Button#AboutCancelDownload", "act": "invoke", "named": "Cancel is pressed in About" },
        { "locator": "Text#DownloadChip", "act": "read", "absent": true, "named": "the download has stopped" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "expect": "Download cancelled", "named": "and the last-run chip says so" }
      ]
    },

    {
      "name": "--open on a photo shows its name and size and lets the operations start",
      "catches": "an open that shows nothing, reports the wrong size, or leaves Generate off with a photo in the window",
      "filed": "MOD8",
      "tags": ["open", "operations"],
      "fixture": "a window opened on the photo fixture",
      "steps": [
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "photo.png · 64 × 48", "named": "the source chip names the photo and its size" },
        { "locator": "Button#ObjectButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "Generate 3D object can be pressed" },
        { "locator": "Button#ReliefButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "and so can Generate relief" },
        { "locator": "Button#ToolbarSaveAs", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and there is no model to save yet" }
      ]
    },

    {
      "name": "a model is turned from the toolbar and the turn undone, each a version",
      "catches": "a turn that does nothing or leaves no version to undo, or an Undo that does not go back to the opened model",
      "filed": "MOD8",
      "tags": ["open", "toolbar", "edit", "history"],
      "fixture": "a window on the cube fixture, to edit",
      "steps": [
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "cube.obj", "named": "the source chip names the model" },
        { "locator": "Text#MeshText", "act": "read", "reads": "name", "expect": "8 vertices · 12 triangles", "named": "the mesh chip counts the cube" },
        { "locator": "Text#LastRun", "act": "read", "absent": true, "named": "nothing has run on it yet" },
        { "locator": "Button#UndoButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "nothing to undo yet" },
        { "locator": "Button#RotateXButton", "act": "invoke", "named": "Turn about X is pressed" },
        {
          "locator": "Text#LastRun",
          "act": "read",
          "reads": "name",
          "matches": "^Turn about X · 12 → 12 triangles · \\d+[.,]\\d s$",
          "named": "the last-run chip reports the turn"
        },
        { "locator": "Button#UndoButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "and Undo can now go back" },
        { "locator": "Button#UndoButton", "act": "invoke", "named": "Undo is pressed" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "expect": "Undone: back to \"Opened\"", "named": "back to the opened model" },
        { "locator": "Button#RedoButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "and the turn can be redone" }
      ]
    },

    {
      "name": "About opens in the window with the version and closes again",
      "catches": "an About button that opens nothing, opens a separate window, or cannot be closed",
      "filed": "MOD11",
      "tags": ["about"],
      "fixture": "a window to open About in",
      "steps": [
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About and models is pressed" },
        { "locator": "Text#AboutVersion", "act": "read", "reads": "name", "matches": "^Version \\d+\\.\\d+\\.\\d+$", "named": "About gives the version" },
        { "locator": "Text#AboutInference", "act": "read", "reads": "name", "matches": "on the CPU\\. No photo is uploaded anywhere\\.$", "named": "where inference runs, and that nothing is uploaded" },
        { "locator": "Button#AboutButton", "act": "read", "reads": "name", "expect": "Back", "named": "the status bar's button now reads Back" },
        { "locator": "Text#DropTitle", "act": "read", "absent": true, "named": "About has taken the stage's place" },
        { "locator": "Window[class=\"#32770\"]", "act": "read", "absent": true, "named": "in the window, not in a dialog" },
        { "locator": "Button#AboutClose", "act": "invoke", "named": "Close is pressed" },
        { "locator": "Text#AboutVersion", "act": "read", "absent": true, "named": "About has closed" },
        { "locator": "Text#DropTitle", "act": "read", "reads": "name", "expect": "Drop a photo or a 3D model here", "named": "and the stage is back" },
        { "locator": "Button#AboutButton", "act": "read", "reads": "name", "expect": "About and models", "named": "with the button named for About again" }
      ]
    },

    {
      "name": "--open on a model that is not there says which file could not be opened",
      "catches": "an open that fails silently, crashes the app on a bad path, or stops the window behind a dialog",
      "filed": "MOD10",
      "tags": ["open"],
      "fixture": "a window asked to open a model that is not there",
      "steps": [
        { "locator": "Text#OpenError", "act": "read", "reads": "name", "expect": "missing.obj was not found.", "named": "the drop zone names the missing file" },
        { "locator": "Window[class=\"#32770\"]", "act": "read", "absent": true, "named": "and no dialog was raised" }
      ]
    }
  ]
}
