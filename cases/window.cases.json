{
  // MOD8: the first cases, read through the accessibility tree. Every later UI task adds its own.
  // Paths are relative to winwright.json's folder, where the app is started. --provider cpu keeps
  // every desk the same, and --releases off keeps the release check (MOD30) off GitHub; none of
  // these needs a model, so none needs .cache\models.

  "fixtures": [
    {
      "name": "the window a default installation opens",
      "arguments": ["--provider", "cpu", "--releases", "off"],
      "shareable": true
    },
    {
      "name": "a window opened on the photo fixture",
      "arguments": ["--open", "cases/fixtures/photo.png", "--provider", "cpu", "--releases", "off"],
      "shareable": true
    },
    {
      // Not lent: its case edits the model.
      "name": "a window on the cube fixture, to edit",
      "arguments": ["--open", "cases/fixtures/cube.obj", "--provider", "cpu", "--releases", "off"],
      "shareable": false
    },
    {
      // Not lent: its case opens About and closes it.
      "name": "a window to open About in",
      "arguments": ["--provider", "cpu", "--releases", "off"],
      "shareable": false
    },
    {
      "name": "a window asked to open a model that is not there",
      "arguments": ["--open", "cases/fixtures/missing.obj", "--provider", "cpu", "--releases", "off"],
      "shareable": true
    },
    {
      // MOD11: downloads from the fixture server CasesRun starts (tests/Modelado.Cases/FixtureServer.cs),
      // into a models folder staged empty. The stand-in is sent at 40 KB/s, so it never finishes here.
      "name": "a window downloading from the fixture server",
      "files": ["cases/fixtures/notes.txt"],
      "arguments": ["--models", "{files}/models", "--manifest", "http://127.0.0.1:47631/files/manifest.json", "--provider", "cpu", "--releases", "off"],
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD13: the cube staged in a folder of its own, so the Save dialog writes there and the
      // written files can be dropped back in.
      "name": "a window on a staged cube, to save through the Export card",
      "files": ["cases/fixtures/cube.obj"],
      "arguments": ["--open", "{files}/cube.obj", "--provider", "cpu", "--releases", "off"],
      "shareable": false
    },
    {
      // MOD21: a photo open, its models folder staged empty, the fixture server's manifest.
      "name": "a window with a photo open, downloading from the fixture server",
      "files": ["cases/fixtures/photo.png"],
      "arguments": ["--open", "{files}/photo.png", "--models", "{files}/relief-models", "--manifest", "http://127.0.0.1:47631/files/manifest.json", "--provider", "cpu", "--releases", "off"],
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD22: the same, with a models folder of its own, so its badges count from nothing.
      "name": "a window with a photo open and a fresh models folder",
      "files": ["cases/fixtures/photo.png"],
      "arguments": ["--open", "{files}/photo.png", "--models", "{files}/first-use-models", "--manifest", "http://127.0.0.1:47631/files/manifest.json", "--provider", "cpu", "--releases", "off"],
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD23: a models folder of its own, which the case fills by downloading and then empties.
      "name": "a window with a photo open, to download and remove a model",
      "files": ["cases/fixtures/photo.png"],
      "arguments": ["--open", "{files}/photo.png", "--models", "{files}/removal-models", "--manifest", "http://127.0.0.1:47631/files/manifest.json", "--provider", "cpu", "--releases", "off"],
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD18: no --provider, and LOCALAPPDATA staged empty, so the choice About saves is this run's own.
      "name": "a window with no saved settings, to choose where inference runs",
      "files": ["cases/fixtures/notes.txt"],
      "arguments": ["--releases", "off"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "shareable": false
    },
    {
      // MOD18: the settings.json an earlier run saved with the CPU chosen, where Modelado looks for it.
      "name": "a window started after the CPU was chosen in About",
      "files": [{ "from": "cases/fixtures/settings-cpu.json", "to": "Modelado/settings.json" }],
      "arguments": ["--releases", "off"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "shareable": false
    },
    {
      // MOD30: the fixture server's release.json stands in for GitHub's API and names v99.0.0, and
      // LOCALAPPDATA is staged empty, so the automatic check is on whatever this desk saved.
      "name": "a window offered a newer release by the fixture server",
      "files": ["cases/fixtures/notes.txt"],
      "arguments": ["--releases", "http://127.0.0.1:47631/files/release.json", "--provider", "cpu"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD37: the photo open, Meshy AI stood in by the fixture server (FixtureServer.Meshy), and
      // LOCALAPPDATA staged empty, so the key the case stores is this run's and no other.
      "name": "a window with the photo open and Meshy AI stood in by the fixture server",
      "files": ["cases/fixtures/photo.png"],
      "arguments": ["--open", "{files}/photo.png", "--provider", "cpu", "--releases", "off", "--cloud-api", "meshy=http://127.0.0.1:47631/meshy/"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD38: the cube staged for saving, with Meshy AI stood in and LOCALAPPDATA of its own.
      "name": "a window on a staged cube with Meshy AI stood in by the fixture server",
      "files": ["cases/fixtures/cube.obj"],
      "arguments": ["--open", "{files}/cube.obj", "--provider", "cpu", "--releases", "off", "--cloud-api", "meshy=http://127.0.0.1:47631/meshy/"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD39: nothing open, Ideogram stood in by the fixture server, LOCALAPPDATA of its own.
      "name": "an empty window with Ideogram stood in by the fixture server",
      "files": ["cases/fixtures/notes.txt"],
      "arguments": ["--provider", "cpu", "--releases", "off", "--cloud-api", "ideogram=http://127.0.0.1:47631/ideogram/"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD37: the settings.json a run left with a Meshy job in flight, and no key beside it.
      "name": "a window started with a cloud job kept from the last run but no key to follow it",
      "files": [{ "from": "cases/fixtures/settings-cloud-job.json", "to": "Modelado/settings.json" }],
      "arguments": ["--provider", "cpu", "--releases", "off", "--cloud-api", "meshy=http://127.0.0.1:47631/meshy/"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD10: not lent, since files are dropped on it.
      "name": "an empty window to drop files on",
      "arguments": ["--provider", "cpu", "--releases", "off"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a default installation puts a window named Modelado on the desk",
      "catches": "an app that builds its window and then shows something else, or nothing at all, which every in-process test would pass",
      "filed": "MOD8",
      "tags": ["smoke", "window"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "Modelado$",
          "named": "the title bar ends in the app's name"
        }
      ]
    },

    {
      "name": "the toolbar offers Open on the empty window and keeps what needs a model off",
      "catches": "a toolbar whose Save as, Undo or turns can be pressed with nothing open, or whose Open cannot",
      "filed": "MOD5",
      "tags": ["smoke", "toolbar"],
      "fixture": "the window a default installation opens",
      "steps": [
        { "locator": "Button#ToolbarOpen", "act": "read", "reads": "name", "expect": "Open", "named": "the toolbar names its Open button" },
        { "locator": "Button#ToolbarOpen", "act": "read", "reads": "enabled", "expect": "enabled", "named": "and it can be pressed" },
        { "locator": "Button#ToolbarSaveAs", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "Save as waits for a model" },
        { "locator": "Button#UndoButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and so does Undo" },
        { "locator": "Button#RotateXButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and so do the turns" },
        { "locator": "Button#ResetViewButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and the front view" },
        { "locator": "Button#SaveViewButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and saving the view (MOD19)" }
      ]
    },

    {
      "name": "the status bar names the provider and holds no run on an empty window",
      "catches": "a provider chip stuck on its placeholder, or a job or last-run chip left showing with nothing run",
      "filed": "MOD9",
      "tags": ["smoke", "status-bar", "provider"],
      "fixture": "the window a default installation opens",
      "steps": [
        { "locator": "Text#ProviderStatus", "act": "read", "reads": "name", "expect": "CPU", "named": "--provider cpu shows as CPU" },
        { "locator": "Text#JobChip", "act": "read", "absent": true, "named": "no run in progress" },
        { "locator": "Text#DownloadChip", "act": "read", "absent": true, "named": "no download in progress" },
        { "locator": "Text#LastRun", "act": "read", "absent": true, "named": "and nothing run yet" },
        { "locator": "Button#UpdateChip", "act": "read", "absent": true, "named": "no update offered with --releases off (MOD30)" },
        { "locator": "Button#AboutButton", "act": "read", "reads": "name", "expect": "About and models", "named": "About sits in the status bar" }
      ]
    },

    {
      "name": "a default installation opens on the drop zone, with the formats and a way to pick a file",
      "catches": "a first screen with nothing on it to open a file with, or an operations panel offering runs with nothing open",
      "filed": "MOD10",
      "tags": ["smoke", "open"],
      "fixture": "the window a default installation opens",
      "steps": [
        { "locator": "Text#DropTitle", "act": "read", "reads": "name", "expect": "Drop a photo or a 3D model here", "named": "the drop zone says what it takes" },
        { "locator": "Text#DropFormats", "act": "read", "reads": "name", "matches": "^Photos: PNG, .*WEBP.*\\n3D models: GLB, OBJ, PLY, STL$", "named": "and lists the formats" },
        { "locator": "Button#OpenButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "Open can be pressed" },
        { "locator": "Button#ObjectButton", "act": "read", "absent": true, "named": "and the operations panel waits for a file" }
      ]
    },

    {
      "name": "a file that is neither a photo nor a model is refused on the drop zone, then a photo and a model switch cleanly",
      "catches": "a drop zone that accepts a drop and opens nothing, a refusal raised as a dialog, or a model that leaves the photo's operations on",
      "filed": "MOD10",
      "tags": ["open", "drop"],
      "fixture": "an empty window to drop files on",
      "steps": [
        { "locator": "Button#OpenButton", "act": "drop file", "with": "cases/fixtures/notes.txt", "named": "a text file is dropped on the drop zone" },
        { "locator": "Text#OpenError", "act": "read", "reads": "name", "expect": "notes.txt is not a photo or a 3D model Modelado can open.", "named": "the drop zone says why" },
        { "locator": "Button#OpenButton", "act": "drop file", "with": "cases/fixtures/photo.png", "named": "a photo is dropped" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "photo.png · 64 × 48", "named": "it opens" },
        { "locator": "Text#OpenError", "act": "read", "absent": true, "named": "and the refusal is gone with the drop zone" },
        { "locator": "Button#ObjectButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "the operations panel has appeared" },
        { "locator": "Image#ViewImage", "act": "drop file", "with": "cases/fixtures/cube.obj", "named": "a model is dropped on the photo" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "cube.obj", "named": "it replaces the photo" },
        { "locator": "Text#MeshText", "act": "read", "reads": "name", "expect": "8 vertices · 12 triangles", "named": "with its counts" },
        { "locator": "Button#ObjectButton", "act": "read", "reads": "enabled", "expect": "not enabled", "named": "and the photo's operations are off" },
        { "locator": "Image#ViewImage", "act": "drop file", "with": "cases/fixtures/notes.txt", "named": "the text file is dropped on the model" },
        { "locator": "Text#ViewerOpenError", "act": "read", "reads": "name", "expect": "notes.txt is not a photo or a 3D model Modelado can open.", "named": "it says why over the model" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "cube.obj", "named": "and the model stays" }
      ]
    },

    {
      "name": "a first-use download says what, how large, from where and under which license, and Not now changes nothing else",
      "catches": "a download offered in a dialog, one that hides its size, source or license, or a decline that leaves the window stuck",
      "filed": "MOD21",
      "tags": ["download", "operations"],
      "fixture": "a window with a photo open, downloading from the fixture server",
      "steps": [
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "matches": "^photo\\.png · ", "named": "the photo is open first (MOD56)" },
        { "locator": "Button#ReliefButton", "act": "invoke", "named": "Generate relief is pressed with no models" },
        { "locator": "Text#ConsentTitle", "act": "read", "reads": "name", "expect": "Relief needs a one-time download", "named": "the offer opens in place of the stage" },
        { "locator": "List#ConsentFiles > ListItem[order=top]", "act": "read", "reads": "name", "expect": "depth-anything-v2-small · FP32 · 1 MB · from 127.0.0.1:47631/files", "named": "the model, its variant, its size and its source" },
        { "locator": "Text#ConsentTotal", "act": "read", "reads": "name", "expect": "Total: 1 MB.", "named": "the total" },
        { "locator": "Text#ConsentFacts", "act": "read", "reads": "name", "matches": "Your photo stays on this computer and is never uploaded\\.", "named": "that only the models are downloaded" },
        { "locator": "Text#ConsentLicense", "act": "read", "reads": "name", "matches": "^depth-anything-v2-small: MIT ", "named": "the license" },
        { "locator": "Button#ConsentAccept", "act": "read", "reads": "name", "expect": "Download and generate the relief", "named": "agreeing names what happens next" },
        { "locator": "Window[class=\"#32770\"]", "act": "read", "absent": true, "named": "all of it in the window, not a dialog" },
        { "locator": "Button#ConsentDecline", "act": "invoke", "named": "Not now is pressed" },
        { "locator": "Text#ConsentTitle", "act": "read", "absent": true, "named": "the offer closes" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "expect": "photo.png · 64 × 48", "named": "the photo is still open" },
        { "locator": "Button#ObjectButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "the other operation is usable" },
        { "locator": "Text#DownloadChip", "act": "read", "absent": true, "named": "and nothing was downloaded" },
        { "locator": "Button#ReliefButton", "act": "invoke", "named": "Generate relief is pressed again" },
        { "locator": "Button#ConsentAccept", "act": "invoke", "named": "and this time the download is accepted" },
        { "locator": "Text#DownloadChip", "act": "read", "reads": "name", "matches": "^Relief: \\d+ of 1 MB", "named": "the download starts, with its chip in the status bar" },
        { "locator": "Button#ReliefFirstUseAction", "act": "invoke", "named": "it is paused from the card" },
        { "locator": "Text#ReliefFirstUseBadge", "act": "read", "reads": "name", "matches": "^Paused · \\d+%$", "named": "and the card says how far it got" },
        { "locator": "Text#DownloadChip", "act": "read", "absent": true, "named": "the status bar no longer shows a download" }
      ]
    },

    {
      "name": "each card says what its first use downloads, and a download paused, resumed and finished runs the operation by itself",
      "catches": "a Generate button whose download is a surprise, a pause that loses the download, or an operation that has to be pressed again once its models are in",
      "filed": "MOD22",
      "tags": ["download", "operations"],
      "fixture": "a window with a photo open and a fresh models folder",
      "steps": [
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "matches": "^photo\\.png · ", "named": "the photo is open first (MOD56)" },
        { "locator": "Text#ObjectFirstUseBadge", "act": "read", "reads": "name", "expect": "One-time download · 4 MB", "named": "the 3D Object card names its download and its size" },
        { "locator": "Text#ReliefFirstUseBadge", "act": "read", "reads": "name", "expect": "One-time download · 1 MB", "named": "and so does the Relief card" },
        { "locator": "Text#ReliefFirstUseDetail", "act": "read", "reads": "name", "expect": "depth-anything-v2-small, from 127.0.0.1:47631/files. Your photo is never uploaded.", "named": "which model, and from where" },
        { "locator": "Button#ReliefButton", "act": "invoke", "named": "Generate relief is pressed" },
        { "locator": "Button#ConsentAccept", "act": "invoke", "named": "the download is agreed to" },
        { "locator": "Text#ReliefFirstUseBadge", "act": "read", "reads": "name", "matches": "^Downloading · \\d+%$", "named": "the card says it is downloading, and how far" },
        { "locator": "Text#ReliefFirstUseDetail", "act": "read", "reads": "name", "matches": "^\\d+ of 1 MB · ", "named": "with the megabytes done of the total" },
        { "locator": "Button#ObjectButton", "act": "read", "reads": "enabled", "expect": "enabled", "named": "and the other operation stays usable meanwhile" },
        { "locator": "Button#ReliefFirstUseAction", "act": "read", "reads": "name", "expect": "Pause", "named": "it offers a pause" },
        { "locator": "Button#ReliefFirstUseAction", "act": "invoke", "named": "Pause is pressed" },
        { "locator": "Text#ReliefFirstUseBadge", "act": "read", "reads": "name", "matches": "^Paused · \\d+%$", "named": "the card says it is paused" },
        { "locator": "Text#ReliefFirstUseDetail", "act": "read", "reads": "name", "expect": "Resume picks up where it stopped; nothing already downloaded is fetched again.", "named": "and that resuming keeps what was downloaded" },
        { "locator": "Button#ReliefFirstUseAction", "act": "read", "reads": "name", "expect": "Resume download", "named": "it offers to resume" },
        { "locator": "Button#ReliefFirstUseAction", "act": "invoke", "named": "Resume download is pressed" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "matches": "^Relief( ·|: )", "named": "the rest arrives and Relief runs by itself (on the stand-in model it ends at once)" }
      ]
    },

    {
      "name": "About lists each download with its size and removes one, and only that card offers its download again",
      "catches": "downloads that can only be removed all at once, a Remove that deletes another model too, or a card that still claims a removed model",
      "filed": "MOD23",
      "tags": ["about", "download"],
      "fixture": "a window with a photo open, to download and remove a model",
      "steps": [
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "matches": "^photo\\.png · ", "named": "the photo is open first (MOD56)" },
        { "locator": "Button#ReliefButton", "act": "invoke", "named": "Generate relief is pressed" },
        { "locator": "Button#ConsentAccept", "act": "invoke", "named": "the download is agreed to" },
        { "locator": "Button#ReliefFirstUseAction", "act": "invoke", "named": "it is paused at once" },
        { "locator": "Button#ReliefFirstUseAction", "act": "read", "reads": "name", "expect": "Resume download", "named": "and offers to resume" },
        { "locator": "Button#ReliefFirstUseAction", "act": "invoke", "named": "resumed, the rest arrives at once" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "expect": "Relief: failed", "named": "Relief runs by itself and fails on the stand-in model" },
        { "locator": "Window[class=\"#32770\"] > Button[name=\"OK\"]", "act": "invoke", "named": "its error is dismissed" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About is opened" },
        { "locator": "Button#Remove-depth-anything-v2-small", "act": "read", "reads": "name", "expect": "Remove depth-anything-v2-small", "named": "the download is listed with a Remove of its own" },
        { "locator": "Text#Download-depth-anything-v2-small", "act": "read", "reads": "name", "expect": "depth-anything-v2-small · fp32 · 1 MB", "named": "with its variant and size" },
        { "locator": "Text#AboutDownloadNote", "act": "read", "reads": "name", "matches": ", where they take 1 MB\\.$", "named": "and the total heads the list" },
        { "locator": "Button#AboutRemoveAll", "act": "invoke", "named": "Remove all downloads is pressed" },
        { "locator": "Text#AboutRemoveAllQuestion", "act": "read", "reads": "name", "matches": "^Delete everything downloaded to ", "named": "it asks in the panel" },
        { "locator": "Window[class=\"#32770\"]", "act": "read", "absent": true, "named": "not in a dialog" },
        { "locator": "Button#AboutRemoveAllKeep", "act": "invoke", "named": "Keep them is pressed" },
        { "locator": "Text#AboutRemoveAllQuestion", "act": "read", "absent": true, "named": "the question goes and nothing is deleted" },
        { "locator": "Button#Remove-depth-anything-v2-small", "act": "invoke", "named": "depth-anything-v2-small alone is removed" },
        { "locator": "Button#Remove-depth-anything-v2-small", "act": "read", "absent": true, "named": "it leaves the list" },
        { "locator": "Text#AboutDownloadNote", "act": "read", "reads": "name", "matches": "Nothing is downloaded yet\\.$", "named": "and the total says so" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "Back is pressed" },
        { "locator": "Text#ReliefFirstUseBadge", "act": "read", "reads": "name", "expect": "One-time download · 1 MB", "named": "the Relief card offers its download again" },
        { "locator": "Text#ObjectFirstUseBadge", "act": "read", "reads": "name", "expect": "One-time download · 4 MB", "named": "and the 3D Object card is as it was" }
      ]
    },

    {
      "name": "About opens and closes during a download whose chip keeps going",
      "catches": "an About that hides a running download, stops it, or takes the status bar with it",
      "filed": "MOD11",
      "tags": ["about", "download", "status-bar"],
      "fixture": "a window downloading from the fixture server",
      "steps": [
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About and models is pressed" },
        { "locator": "Button#AboutDownloadAll", "act": "invoke", "named": "Download everything is pressed" },
        { "locator": "Button#ConsentAccept", "act": "invoke", "named": "the download is agreed to in the consent panel" },
        { "locator": "Text#DownloadChip", "act": "read", "reads": "name", "matches": "^Downloading models: \\d+ of \\d+ MB", "named": "the status bar shows the download" },
        { "locator": "Text#AboutDownloadStatus", "act": "read", "reads": "name", "matches": "^Downloading models: \\d+ of \\d+ MB", "named": "and About, back in place, does too" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "Back is pressed" },
        { "locator": "Text#AboutVersion", "act": "read", "absent": true, "named": "About has closed" },
        { "locator": "Text#DownloadChip", "act": "read", "reads": "name", "matches": "^Downloading models: \\d+ of \\d+ MB", "named": "the download is still going" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About is opened again" },
        { "locator": "Button#AboutCancelDownload", "act": "invoke", "named": "Cancel is pressed in About" },
        { "locator": "Text#DownloadChip", "act": "read", "absent": true, "named": "the download has stopped" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "expect": "Download cancelled", "named": "and the last-run chip says so" }
      ]
