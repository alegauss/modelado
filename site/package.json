{
  "name": "modelado-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The public site for Modelado: every word in one module, the chrome from the design system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/pack-models.mjs && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "check:models": "node scripts/check-models.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@viglet/viglet-design-system": "2026.3.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "24.19.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "gltfpack": "1.3.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
