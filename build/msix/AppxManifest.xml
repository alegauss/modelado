<?xml version="1.0" encoding="utf-8"?>
<!--
  MOD73: the Microsoft Store package, after claude-tray's build\msix\AppxManifest.xml (T409).
  build\build-msix.ps1 fills {VERSION} from <Version> in Directory.Build.props, so the version still
  lives in one place; the Store requires the fourth part to be 0.

  Identity is the Partner Center reservation (account Alegauss, Store ID 9PB86WW5NRR2, Package
  Family Name Alegauss.Modelado_d7cpypw1jc0bm). The Store signs the package, so Name and Publisher
  must match the reservation exactly or the upload is refused.

  MOD76: a package's folder under WindowsApps cannot be started from outside it, so modelado-cli
  carries an execution alias, on PATH for every shell under %LOCALAPPDATA%\Microsoft\WindowsApps,
  which the Blender add-on falls back to. The window has none of its own (MOD79): the add-on and a
  terminal start it as "modelado-cli window".
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop4 rescap">

  <Identity Name="Alegauss.Modelado"
            Publisher="CN=1ADDE401-7D09-4729-8E49-C28AEEA80170"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Modelado</DisplayName>
    <PublisherDisplayName>Alegauss</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 10 1903, the minimum the README and installer.iss name. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <!-- SupportsMultipleInstances, which the console alias requires, keeps what the unpackaged build
         does: each start is its own process, as two windows or a CLI run beside a window are. -->
    <Application Id="Modelado" Executable="Modelado.exe" EntryPoint="Windows.FullTrustApplication"
                 desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Modelado"
        Description="Photos into 3D models, with AI models running on your own PC."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- MOD75: "Open with Modelado" for the models the app opens, as installer.iss writes it for
             the unpackaged build. A package's own registry writes land in its private hive, where
             Explorer never looks, so the package declares them here. The file arrives as the first
             argument, the bare path CommandLine.cs already opens. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="modelado.model">
            <uap:DisplayName>3D model</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.glb</uap:FileType>
              <uap:FileType>.obj</uap:FileType>
              <uap:FileType>.ply</uap:FileType>
              <uap:FileType>.stl</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- MOD79: one alias, modelado-cli's, naming its own executable on this one application. An
             application may declare one alias extension, and a second Application with
             AppListEntry="none" is what the Store refused on the first upload as headless (it needs
             the HeadlessAppBypass waiver). The window is reached through it: modelado-cli window. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="modelado-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="modelado-cli.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
