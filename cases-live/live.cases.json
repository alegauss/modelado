{
  // MOD61: the cases on the real models, run by run-live-vm.cmd and never by the gate. run-live.cmd
  // has downloaded every model into the default models folder before these start, so no consent
  // panel opens. Windows answers that folder from the real profile, whatever LOCALAPPDATA says, so
  // a fixture can stage LOCALAPPDATA empty for settings of its own and still find the models.

  "fixtures": [
    {
      "name": "a window on the robot photo with the real models and no saved settings",
      "files": [{ "from": "docs/robot.png", "to": "robot.png" }],
      "arguments": ["--open", "{files}/robot.png", "--releases", "off"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "shareable": false
    },
    {
      // MOD40: the robot photo with Ideogram stood in, so a relief made on the real models can take a texture.
      "name": "a window on the robot photo with Ideogram stood in and the real models",
      "files": [{ "from": "docs/robot.png", "to": "robot.png" }],
      "arguments": ["--open", "{files}/robot.png", "--provider", "cpu", "--releases", "off", "--cloud-api", "ideogram=http://127.0.0.1:47631/ideogram/"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    },
    {
      // MOD39: Ideogram stood in by the fixture server (FixtureServer.Ideogram), the real models for TripoSR.
      "name": "an empty window with Ideogram stood in and the real models",
      "files": ["cases/fixtures/notes.txt"],
      "arguments": ["--provider", "cpu", "--releases", "off", "--cloud-api", "ideogram=http://127.0.0.1:47631/ideogram/"],
      "variables": { "LOCALAPPDATA": "{files}" },
      "reaches": ["127.0.0.1:47631"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a 3D Object and a Relief on the real models show their job chip, then a last run on the CPU chosen in About",
      "catches": "a reconstruction the status bar never shows, a last-run chip naming another provider, or a window that samples differently from modelado-cli",
      "filed": "MOD53",
      "tags": ["status-bar", "object", "relief", "provider"],
      "fixture": "a window on the robot photo with the real models and no saved settings",
      "steps": [
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "matches": "^robot\\.png · ", "named": "the photo is open first" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About is opened" },
        { "locator": "RadioButton#ProviderCpu", "act": "select", "reads": "selected", "expect": "selected", "named": "the CPU is chosen (MOD18)" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "Back is pressed" },
        { "locator": "Group#ObjectAdvanced", "act": "expand", "reads": "expanded", "expect": "Expanded", "named": "Advanced opens" },
        { "locator": "CheckBox#ObjectEveryPoint", "act": "toggle", "reads": "toggle", "expect": "On", "named": "step 1 (MOD17)" },
        { "locator": "Slider#ObjectSmoothing", "act": "set range", "with": "0", "reads": "range", "expect": "0", "named": "no smoothing (MOD17)" },
        { "locator": "Button#ObjectButton", "act": "invoke", "named": "Generate 3D object is pressed" },
        { "locator": "Text#JobChip", "act": "read", "reads": "name", "matches": "^3D Object: ", "named": "the job chip shows the 3D Object running" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "matches": "^3D Object · \\d+\\.\\d s · CPU$", "named": "then the last run, on the CPU (MOD18)" },
        { "locator": "Text#JobChip", "act": "read", "absent": true, "named": "and the job chip is gone" },
        { "locator": "Text#MeshText", "act": "read", "reads": "name", "expect": "43,264 vertices · 86,524 triangles", "named": "the counts modelado-cli object --step 1 --smooth 0 gives on the same photo (MOD17)" },
        { "locator": "ComboBox#ReliefResolution", "act": "expand", "named": "the relief resolutions are opened" },
        { "locator": "ComboBox#ReliefResolution > ListItem[nameStarts=\"512\"]", "act": "select", "reads": "selected", "expect": "selected", "named": "512, so the run lasts long enough to be read" },
        { "locator": "CheckBox#ReliefRemoveBackground", "act": "toggle", "reads": "toggle", "expect": "On", "named": "and the background removed first" },
        { "locator": "Button#ReliefButton", "act": "invoke", "named": "Generate relief is pressed" },
        { "locator": "Text#JobChip", "act": "read", "reads": "name", "matches": "^Relief: ", "named": "the job chip shows the Relief running" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "matches": "^Relief · \\d+\\.\\d s · CPU$", "named": "then its last run, on the CPU" }
      ]
    },

    {
      "name": "a relief takes a stone texture drawn from a description, and Undo brings back its photo",
      "catches": "a drawn texture that a textured relief does not take, or an Undo that loses the photo it was made from",
      "filed": "MOD40",
      "tags": ["cloud", "relief", "edit", "history"],
      "fixture": "a window on the robot photo with Ideogram stood in and the real models",
      "steps": [
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "matches": "^robot\\.png · ", "named": "the photo is open first" },
        { "locator": "Button#ReliefButton", "act": "invoke", "named": "Generate relief is pressed" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "matches": "^Relief · \\d+\\.\\d s · CPU$", "named": "the relief is made, textured with the photo" },
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About is opened" },
        { "locator": "Edit#CloudKey-ideogram", "act": "set value", "with": "case-ideogram-key", "named": "the Ideogram key is typed" },
        { "locator": "Button#CloudSave-ideogram", "act": "invoke", "named": "and saved" },
        { "locator": "Text#CloudStatus-ideogram", "act": "read", "reads": "name", "expect": "The key works.", "named": "once the stand-in accepts it" },
        { "locator": "Button#AboutClose", "act": "invoke", "named": "About is closed" },
        { "locator": "Button#NewTextureButton", "act": "invoke", "named": "New texture with Ideogram is pressed" },
        { "locator": "Edit#NewTexturePrompt", "act": "set value", "with": "weathered grey stone", "reads": "value", "expect": "weathered grey stone", "named": "the material is described" },
        { "locator": "Button#NewTextureRun", "act": "invoke", "named": "Draw is pressed" },
        { "locator": "Button#NewTextureSend", "act": "invoke", "named": "Send it is pressed" },
        { "locator": "Button#TextureCandidate-1", "act": "invoke", "named": "the first texture is chosen" },
        { "locator": "List#History > ListItem[order=bottom]", "act": "read", "reads": "name", "expect": "2. New texture: weathered grey stone", "named": "the relief takes it as its next version" },
        { "locator": "Text#MeshText", "act": "read", "reads": "name", "matches": "texture \\d+ × \\d+", "named": "still textured" },
        { "locator": "Button#UndoButton", "act": "invoke", "named": "Undo is pressed" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "expect": "Undone: back to \"Relief\"", "named": "and the relief with its photo is back" }
      ]
    },

    {
      "name": "a candidate drawn from a description becomes a TripoSR model on the real models",
      "catches": "a drawn photo that opens but that the 3D Object cannot take, or a reconstruction that drops it",
      "filed": "MOD39",
      "tags": ["cloud", "object"],
      "fixture": "an empty window with Ideogram stood in and the real models",
      "steps": [
        { "locator": "Button#AboutButton", "act": "invoke", "named": "About is opened" },
        { "locator": "Edit#CloudKey-ideogram", "act": "set value", "with": "case-ideogram-key", "named": "the Ideogram key is typed" },
        { "locator": "Button#CloudSave-ideogram", "act": "invoke", "named": "and saved" },
        { "locator": "Text#CloudStatus-ideogram", "act": "read", "reads": "name", "expect": "The key works.", "named": "once the stand-in accepts it" },
        { "locator": "Button#AboutClose", "act": "invoke", "named": "About is closed" },
        { "locator": "Button#DropGenerate", "act": "invoke", "named": "Generate a photo with Ideogram is pressed" },
        { "locator": "Edit#GeneratePrompt", "act": "set value", "with": "a red ball", "reads": "value", "expect": "a red ball", "named": "the object is described" },
        { "locator": "Button#GenerateRun", "act": "invoke", "named": "Generate is pressed" },
        { "locator": "Button#GenerateSend", "act": "invoke", "named": "Send it is pressed" },
        { "locator": "Button#Candidate-1", "act": "invoke", "named": "the first candidate is chosen" },
        { "locator": "Text#SourceText", "act": "read", "reads": "name", "matches": "^ideogram-\\d{8}-\\d{6}-1\\.png · ", "named": "it opens as a photo" },
        { "locator": "Button#ObjectButton", "act": "invoke", "named": "Generate 3D object is pressed" },
        { "locator": "Text#JobChip", "act": "read", "reads": "name", "matches": "^3D Object: ", "named": "TripoSR runs on it" },
        { "locator": "Text#LastRun", "act": "read", "reads": "name", "matches": "^3D Object · \\d+\\.\\d s · CPU$", "named": "and finishes" },
        { "locator": "Text#MeshText", "act": "read", "reads": "name", "matches": "^[\\d,]+ vertices · [\\d,]+ triangles", "named": "with a mesh made from the drawn photo" },
        { "locator": "List#History > ListItem[order=top]", "act": "read", "reads": "name", "matches": "^1\\. ", "named": "as the first version" }
      ]
    }
  ]
}
