<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF shell, and the only assembly that sees every library. Windows only: it builds on
       Linux (EnableWindowsTargeting) to be compile-checked, and runs on Windows 10 and 11. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Modelado.App</RootNamespace>
    <AssemblyName>Modelado</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Per-Monitor V2 DPI awareness, so the viewer renders at the screen's own pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <!-- WPF0001: ThemeMode is still marked [Experimental] and is the supported way to follow
         the system's light or dark theme with the Fluent styles. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- MOD7: the icon the exe carries in Explorer; the window takes the same file as a resource.
         tools\Modelado.Icon draws it. -->
    <ApplicationIcon>Modelado.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Modelado.ico" />
  </ItemGroup>

  <!-- MOD85: every string the interface shows, in English, the neutral culture a translation's
       Strings.<culture>.resx fills. The Strings class is generated from it at build time, into
       obj, so the file and the class cannot drift apart; XAML reads it through x:Static. -->
  <ItemGroup>
    <Using Include="Modelado.App.Properties" />
    <EmbeddedResource Update="Properties\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Modelado.App.Properties</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The class has to exist before the XAML is compiled, and WPF's temporary markup assembly
       (the *_wpftmp project, the one build that sets _TargetAssemblyProjectName) runs no resource
       generation of its own: so it is generated first and handed to that build by path. -->
  <Target Name="GenerateStringsBeforeMarkup" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;CoreResGen" />
  <ItemGroup Condition="'$(_TargetAssemblyProjectName)' != ''">
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modelado.Imaging\Modelado.Imaging.csproj" />
    <ProjectReference Include="..\Modelado.Geometry\Modelado.Geometry.csproj" />
    <ProjectReference Include="..\Modelado.Inference\Modelado.Inference.csproj" />
    <ProjectReference Include="..\Modelado.Cloud\Modelado.Cloud.csproj" />
  </ItemGroup>

</Project>
