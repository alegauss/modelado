<Window x:Class="Modelado.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Modelado.App"
        xmlns:p="clr-namespace:Modelado.App.Properties"
        Title="{x:Static p:Strings.AppName}"
        Icon="pack://application:,,,/Modelado.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        FontFamily="{StaticResource AppFont}"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <!-- Auto, so the viewer takes the whole width until the operations panel appears (MOD10). -->
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- MOD5: the toolbar, after PhotoBoost's (PB63, PB65, PB66). Its groups, in order: Open and
         Save as; Undo and Redo; the quarter turns and Mirror. On the right, how the model is
         shown and the front view, as PhotoBoost places its compare modes. Each button is a glyph
         with an accessible name, an AutomationId and a tooltip naming its shortcut, and goes
         through a command, so the button and the key share one CanExecute: what needs a model
         is off without one, and everything but the view waits for a running operation. A WPF
         ToolBar moves what does not fit into its overflow menu rather than clipping it. -->
    <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="12,8,12,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{x:Static p:Strings.ViewLabel}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ComboBox x:Name="ViewChoice" AutomationProperties.AutomationId="ViewChoice" AutomationProperties.Name="View"
                  Width="150" SelectedIndex="0" SelectionChanged="OnViewChanged" IsEnabled="False">
          <ComboBoxItem Content="{x:Static p:Strings.ModelInColour}" />
          <ComboBoxItem Content="{x:Static p:Strings.ModelInClay}" />
          <ComboBoxItem Content="{x:Static p:Strings.MeshEdges}" />
          <ComboBoxItem Content="{x:Static p:Strings.InputPhoto}" />
        </ComboBox>
        <Button x:Name="ResetViewButton" AutomationProperties.AutomationId="ResetViewButton" AutomationProperties.Name="Front view"
                Command="{x:Static local:MainWindow.ResetViewCommand}" Margin="6,0,0,0" Padding="8,4"
                ToolTip="{x:Static p:Strings.ResetViewButtonTip}">
          <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE80F;" />
        </Button>
        <!-- MOD19: the view shown, drawn again at the size the dialog's file type names. -->
        <Button x:Name="SaveViewButton" AutomationProperties.AutomationId="SaveViewButton" AutomationProperties.Name="Save view as image"
                Command="{x:Static local:MainWindow.SaveViewCommand}" Margin="2,0,0,0" Padding="8,4"
                ToolTip="{x:Static p:Strings.SaveViewButtonTip}">
          <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE722;" />
        </Button>
      </StackPanel>
      <ToolBarTray Background="Transparent" IsLocked="True" Margin="0,0,12,0">
        <ToolBar x:Name="EditorToolbar" AutomationProperties.AutomationId="EditorToolbar" AutomationProperties.Name="Editor"
                 Background="Transparent">
          <Button x:Name="ToolbarOpen" AutomationProperties.AutomationId="ToolbarOpen" AutomationProperties.Name="Open"
                  Command="Open"
                  ToolTip="{x:Static p:Strings.ToolbarOpenTip}">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8E5;" />
          </Button>
          <Button x:Name="ToolbarSaveAs" AutomationProperties.AutomationId="ToolbarSaveAs" AutomationProperties.Name="Save as"
                  Command="SaveAs" ToolTip="{x:Static p:Strings.ToolbarSaveAsTip}">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE792;" />
          </Button>
          <!-- MOD46: shown only when the Blender add-on opened this window on one of its objects. -->
          <Button x:Name="SendToBlenderButton" AutomationProperties.AutomationId="SendToBlenderButton" AutomationProperties.Name="Send to Blender"
                  Visibility="Collapsed" Click="OnSendToBlender"
                  ToolTip="{x:Static p:Strings.SendToBlenderButtonTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE72A;" Margin="4,2,2,2" />
              <TextBlock Text="{x:Static p:Strings.SendToBlender}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
            </StackPanel>
          </Button>
          <Separator />
          <Button x:Name="UndoButton" AutomationProperties.AutomationId="UndoButton" AutomationProperties.Name="Undo"
                  Command="Undo" ToolTip="{x:Static p:Strings.UndoButtonTip}">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7A7;" />
          </Button>
          <Button x:Name="RedoButton" AutomationProperties.AutomationId="RedoButton" AutomationProperties.Name="Redo"
                  Command="Redo" ToolTip="{x:Static p:Strings.RedoButtonTip}">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7A6;" />
          </Button>
          <Separator />
          <!-- The font has one rotate glyph; the axis it turns about is written beside it. -->
          <Button x:Name="RotateXButton" AutomationProperties.AutomationId="RotateXButton" AutomationProperties.Name="Turn about X"
                  Command="{x:Static local:MainWindow.RotateXCommand}" ToolTip="{x:Static p:Strings.RotateXButtonTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7AD;" Margin="4,2,1,2" />
              <TextBlock Text="X" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
            </StackPanel>
          </Button>
          <Button x:Name="RotateYButton" AutomationProperties.AutomationId="RotateYButton" AutomationProperties.Name="Turn about Y"
                  Command="{x:Static local:MainWindow.RotateYCommand}" ToolTip="{x:Static p:Strings.RotateYButtonTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7AD;" Margin="4,2,1,2" />
              <TextBlock Text="Y" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
            </StackPanel>
          </Button>
          <Button x:Name="RotateZButton" AutomationProperties.AutomationId="RotateZButton" AutomationProperties.Name="Turn about Z"
                  Command="{x:Static local:MainWindow.RotateZCommand}" ToolTip="{x:Static p:Strings.RotateZButtonTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7AD;" Margin="4,2,1,2" />
              <TextBlock Text="Z" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
            </StackPanel>
          </Button>
          <Button x:Name="MirrorButton" AutomationProperties.AutomationId="MirrorButton" AutomationProperties.Name="Mirror"
                  Command="{x:Static local:MainWindow.MirrorCommand}" ToolTip="{x:Static p:Strings.MirrorButtonTip}">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8AB;" />
          </Button>
        </ToolBar>
      </ToolBarTray>
    </DockPanel>

    <!-- Viewer -->
    <Border x:Name="ViewerFrame" Grid.Row="1" Grid.Column="0" Margin="12,0,6,0" CornerRadius="8" ClipToBounds="True"
            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <Grid x:Name="Viewport" AutomationProperties.AutomationId="Viewport" Background="{DynamicResource ViewportGroundBrush}" SizeChanged="OnViewportSizeChanged"
            MouseLeftButtonDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove" MouseLeftButtonUp="OnViewportMouseUp"
            MouseWheel="OnViewportMouseWheel">
        <Image x:Name="ViewImage" AutomationProperties.AutomationId="ViewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <!-- MOD10, after PhotoBoost's DropZone (PB23): what can be opened, a way to pick it, the
             advice, and where a file that could not be opened is said. The window takes a drop
             anywhere on it. -->
        <Border x:Name="EmptyHint" AutomationProperties.AutomationId="DropZone" Style="{StaticResource GroupCard}"
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="460" Padding="28,24" Margin="0">
          <StackPanel>
            <TextBlock x:Name="DropTitle" AutomationProperties.AutomationId="DropTitle" Text="{x:Static p:Strings.DropTitle}"
                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="DropFormats" AutomationProperties.AutomationId="DropFormats" Style="{StaticResource StatCaption}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
            <Button x:Name="OpenButton" AutomationProperties.AutomationId="OpenButton" Content="{x:Static p:Strings.OpenButton}" Command="Open"
                    Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="24,8" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource StatCaption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0"
                       Text="{x:Static p:Strings.DropAdvice}" />
            <TextBlock x:Name="OpenError" AutomationProperties.AutomationId="OpenError" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <!-- MOD39: no photo yet? One drawn by a cloud service that holds a key, from a description
                 wrapped in what reconstruction needs, which the user sees and can change. -->
            <Button x:Name="DropGenerate" AutomationProperties.AutomationId="DropGenerate" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Padding="16,4" Click="OnDropGenerate" Visibility="Collapsed" />
            <StackPanel x:Name="GeneratePanel" AutomationProperties.AutomationId="GeneratePanel" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBlock Text="{x:Static p:Strings.TheObject}" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="GeneratePrompt" AutomationProperties.AutomationId="GeneratePrompt" AutomationProperties.Name="The object"
                       MaxLength="300" TextChanged="OnGenerateChanged" ToolTip="{x:Static p:Strings.GeneratePromptTip}" />
              <TextBlock Text="{x:Static p:Strings.AskedAs}" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="GenerateTemplate" AutomationProperties.AutomationId="GenerateTemplate" AutomationProperties.Name="Asked as"
                       TextWrapping="Wrap" AcceptsReturn="False" TextChanged="OnGenerateChanged"
                       Text="{x:Static p:Strings.GenerateTemplate}"
                       ToolTip="{x:Static p:Strings.GenerateTemplateTip}" />
              <UniformGrid Columns="3" Margin="0,8,0,0">
                <ComboBox x:Name="GenerateAspect" AutomationProperties.AutomationId="GenerateAspect" AutomationProperties.Name="Shape" Margin="0,0,4,0"
                          SelectedIndex="0" SelectionChanged="OnGenerateOptionChanged">
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateAspectSquare}" Tag="1x1" />
                  <ComboBoxItem Content="4:3" Tag="4x3" />
                  <ComboBoxItem Content="3:4" Tag="3x4" />
                </ComboBox>
                <ComboBox x:Name="GenerateSpeed" AutomationProperties.AutomationId="GenerateSpeed" AutomationProperties.Name="Quality" Margin="2,0,2,0"
                          SelectedIndex="0" SelectionChanged="OnGenerateOptionChanged">
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateSpeedQuick}" Tag="turbo" />
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateSpeedDefault}" Tag="default" />
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateSpeedBest}" Tag="quality" />
                </ComboBox>
                <ComboBox x:Name="GenerateCount" AutomationProperties.AutomationId="GenerateCount" AutomationProperties.Name="Candidates" Margin="4,0,0,0"
                          SelectedIndex="3" SelectionChanged="OnGenerateOptionChanged">
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateCountOne}" Tag="1" />
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateCountTwo}" Tag="2" />
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateCountThree}" Tag="3" />
                  <ComboBoxItem Content="{x:Static p:Strings.GenerateCountFour}" Tag="4" />
                </ComboBox>
              </UniformGrid>
              <Button x:Name="GenerateRun" AutomationProperties.AutomationId="GenerateRun" Margin="0,10,0,0" Padding="0,6" HorizontalAlignment="Stretch"
                      Style="{DynamicResource AccentButtonStyle}" Click="OnGenerateRun" />
              <Border x:Name="GenerateConsent" AutomationProperties.AutomationId="GenerateConsent" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="GenerateConsentText" AutomationProperties.AutomationId="GenerateConsentText" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="GenerateSend" AutomationProperties.AutomationId="GenerateSend" Content="{x:Static p:Strings.SendIt}" Padding="12,2" Click="OnGenerateSend" />
                    <Button x:Name="GenerateCancel" AutomationProperties.AutomationId="GenerateCancel" Content="{x:Static p:Strings.NotNow}" Padding="12,2" Margin="8,0,0,0"
                            Click="OnGenerateNotNow" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock x:Name="GenerateStatus" AutomationProperties.AutomationId="GenerateStatus" Style="{StaticResource StatCaption}" Margin="0,8,0,0"
                         TextWrapping="Wrap" />
              <!-- The candidates side by side; the one pressed opens as if it had been dropped. -->
              <WrapPanel x:Name="GenerateCandidates" AutomationProperties.AutomationId="GenerateCandidates" Margin="0,6,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- MOD10, after PhotoBoost's ViewerOpenError (PB64): a file that could not be opened while
             something is shown is said over it, and what is shown stays. -->
        <Border x:Name="ViewerOpenErrorBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                Padding="12,6" CornerRadius="6" Visibility="Collapsed"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
          <TextBlock x:Name="ViewerOpenError" AutomationProperties.AutomationId="ViewerOpenError" TextWrapping="Wrap" MaxWidth="560"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </Border>
        <TextBlock x:Name="ViewerHint" AutomationProperties.AutomationId="ViewerHint" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,10" Visibility="Collapsed"
                   Foreground="{DynamicResource HintTextBrush}" FontSize="12" Text="{x:Static p:Strings.ViewerHint}" />
      </Grid>
    </Border>

    <!-- Operations. MOD6, after PhotoBoost's PB60: the run in progress is pinned above the cards,
         outside their scrolling, so its progress, its Cancel and its end are seen however far the
         cards have scrolled. Pause shows for a download only, which is what it is for. -->
    <DockPanel x:Name="Operations" Grid.Row="1" Grid.Column="1" Width="340" Margin="6,0,12,0" Visibility="Collapsed">
      <TextBlock DockPanel.Dock="Top" Text="{x:Static p:Strings.OperationsTitle}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
      <Border x:Name="ProgressCard" AutomationProperties.AutomationId="JobPanel" DockPanel.Dock="Top"
              Style="{StaticResource GroupCard}" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" DockPanel.Dock="Right"
                    Content="{x:Static p:Strings.Cancel}" Padding="12,2" Click="OnCancel" />
            <Button x:Name="PauseButton" AutomationProperties.AutomationId="PauseButton" DockPanel.Dock="Right"
                    Content="{x:Static p:Strings.PauseButton}" Padding="12,2" Margin="0,0,8,0" Click="OnPauseDownload" Visibility="Collapsed" />
            <TextBlock x:Name="ProgressTitle" AutomationProperties.AutomationId="JobTitle" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ProgressBar x:Name="ProgressBar" AutomationProperties.AutomationId="JobProgress" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,0" />
          <TextBlock x:Name="ProgressText" AutomationProperties.AutomationId="JobStatus" Style="{StaticResource StatCaption}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    <ScrollViewer x:Name="OperationsScroll" AutomationProperties.AutomationId="OperationsScroll" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border Style="{StaticResource GroupCard}">
          <StackPanel>
            <TextBlock Text="{x:Static p:Strings.ObjectCardTitle}" Style="{StaticResource SectionHeader}" />
            <TextBlock Style="{StaticResource StatCaption}"
                       Text="{x:Static p:Strings.ObjectCardCaption}" />
            <TextBlock Text="{x:Static p:Strings.MeshResolution}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ObjectResolution" AutomationProperties.AutomationId="ObjectResolution" SelectedIndex="2">
              <ComboBoxItem Content="{x:Static p:Strings.ObjectResolution128}" Tag="128" />
              <ComboBoxItem Content="192" Tag="192" />
              <ComboBoxItem Content="{x:Static p:Strings.ObjectResolution256}" Tag="256" />
              <ComboBoxItem Content="320" Tag="320" />
              <ComboBoxItem Content="{x:Static p:Strings.ObjectResolution384}" Tag="384" />
            </ComboBox>
            <TextBlock x:Name="ThresholdText" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="ObjectThreshold" AutomationProperties.AutomationId="ObjectThreshold" Minimum="5" Maximum="50" Value="25" TickFrequency="5" IsSnapToTickEnabled="False"
                    ValueChanged="OnThresholdChanged"
                    ToolTip="{x:Static p:Strings.ObjectThresholdTip}" />
            <CheckBox x:Name="ObjectRemoveBackground" AutomationProperties.AutomationId="ObjectRemoveBackground" Content="{x:Static p:Strings.ObjectRemoveBackground}" IsChecked="True" Margin="0,8,0,0"
                      ToolTip="{x:Static p:Strings.ObjectRemoveBackgroundTip}" />
            <CheckBox x:Name="ObjectProjectPhoto" AutomationProperties.AutomationId="ObjectProjectPhoto" Content="{x:Static p:Strings.ObjectProjectPhoto}" IsChecked="True" Margin="0,4,0,0"
                      ToolTip="{x:Static p:Strings.ObjectProjectPhotoTip}" />
            <CheckBox x:Name="ObjectEnhancePhoto" AutomationProperties.AutomationId="ObjectEnhancePhoto" Content="{x:Static p:Strings.ObjectEnhancePhoto}" Margin="0,4,0,0" Click="OnEnhanceChanged"
                      ToolTip="{x:Static p:Strings.ObjectEnhancePhotoTip}" />
            <!-- MOD17: the CLI's -\-step and -\-smooth, and the loose-piece share it fixes, closed by default. -->
            <Expander x:Name="ObjectAdvanced" AutomationProperties.AutomationId="ObjectAdvanced" Header="{x:Static p:Strings.ObjectAdvancedHeader}" Margin="0,8,0,0" IsExpanded="False">
              <StackPanel Margin="0,4,0,0">
                <CheckBox x:Name="ObjectEveryPoint" AutomationProperties.AutomationId="ObjectEveryPoint" Content="{x:Static p:Strings.ObjectEveryPoint}"
                          ToolTip="{x:Static p:Strings.ObjectEveryPointTip}" />
                <TextBlock x:Name="ObjectSmoothingText" Style="{StaticResource FieldLabel}" AutomationProperties.AutomationId="ObjectSmoothingLabel" />
                <Slider x:Name="ObjectSmoothing" AutomationProperties.AutomationId="ObjectSmoothing" AutomationProperties.Name="Smoothing passes"
                        Minimum="0" Maximum="6" Value="2" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                        ValueChanged="OnObjectAdvancedChanged"
                        ToolTip="{x:Static p:Strings.ObjectSmoothingTip}" />
                <TextBlock x:Name="ObjectPiecesText" Style="{StaticResource FieldLabel}" AutomationProperties.AutomationId="ObjectPiecesLabel" />
                <Slider x:Name="ObjectPieces" AutomationProperties.AutomationId="ObjectPieces" AutomationProperties.Name="Drop loose pieces under"
                        Minimum="0" Maximum="20" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                        ValueChanged="OnObjectAdvancedChanged"
                        ToolTip="{x:Static p:Strings.ObjectPiecesTip}" />
              </StackPanel>
            </Expander>
            <Button x:Name="ObjectButton" AutomationProperties.AutomationId="ObjectButton" Content="{x:Static p:Strings.ObjectButton}" Margin="0,12,0,0" Padding="0,8" HorizontalAlignment="Stretch"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnGenerateObject" IsEnabled="False" />
            <!-- MOD22, after PhotoBoost's first-use blocks (PB58): what the first use downloads, how
                 large, its progress, and Pause, Resume or Try again. -->
            <Border x:Name="ObjectFirstUse" AutomationProperties.AutomationId="ObjectFirstUse" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ObjectFirstUseBadge" AutomationProperties.AutomationId="ObjectFirstUseBadge" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ObjectFirstUseDetail" AutomationProperties.AutomationId="ObjectFirstUseDetail" Style="{StaticResource StatCaption}" Margin="0,4,0,0" />
                <ProgressBar x:Name="ObjectFirstUseProgress" AutomationProperties.AutomationId="ObjectFirstUseProgress" Height="4" Maximum="100" Margin="0,2,0,6" Visibility="Collapsed" />
                <Button x:Name="ObjectFirstUseAction" AutomationProperties.AutomationId="ObjectFirstUseAction" HorizontalAlignment="Left" Padding="12,2"
                        Visibility="Collapsed" Click="OnFirstUseAction" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource GroupCard}">
          <StackPanel>
            <TextBlock Text="{x:Static p:Strings.ReliefCardTitle}" Style="{StaticResource SectionHeader}" />
            <TextBlock Style="{StaticResource StatCaption}"
                       Text="{x:Static p:Strings.ReliefCardCaption}" />
            <!-- MOD27: shown only when an added source lists a depth model of its own. -->
            <StackPanel x:Name="ReliefDepthModelPanel" Visibility="Collapsed">
              <TextBlock Text="{x:Static p:Strings.DepthModel}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="ReliefDepthModel" AutomationProperties.AutomationId="ReliefDepthModel" AutomationProperties.Name="Depth model"
                        DisplayMemberPath="Label" SelectionChanged="OnReliefDepthModelChanged" />
            </StackPanel>
            <TextBlock Text="{x:Static p:Strings.MeshResolution}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ReliefResolution" AutomationProperties.AutomationId="ReliefResolution" SelectedIndex="1">
              <ComboBoxItem Content="128" Tag="128" />
              <ComboBoxItem Content="{x:Static p:Strings.ReliefResolution256}" Tag="256" />
              <ComboBoxItem Content="384" Tag="384" />
              <ComboBoxItem Content="{x:Static p:Strings.ReliefResolution512}" Tag="512" />
            </ComboBox>
            <TextBlock x:Name="DepthText" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="ReliefDepth" AutomationProperties.AutomationId="ReliefDepth" Minimum="0.05" Maximum="0.6" Value="0.25" ValueChanged="OnReliefSliderChanged"
                    ToolTip="{x:Static p:Strings.ReliefDepthTip}" />
            <TextBlock x:Name="BaseText" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="ReliefBase" AutomationProperties.AutomationId="ReliefBase" Minimum="0" Maximum="0.2" Value="0" ValueChanged="OnReliefSliderChanged"
                    ToolTip="{x:Static p:Strings.ReliefBaseTip}" />
            <CheckBox x:Name="ReliefRemoveBackground" AutomationProperties.AutomationId="ReliefRemoveBackground" Content="{x:Static p:Strings.ReliefRemoveBackground}" Margin="0,8,0,0" Click="OnReliefCutOutChanged" />
            <Button x:Name="ReliefButton" AutomationProperties.AutomationId="ReliefButton" Content="{x:Static p:Strings.ReliefButton}" Margin="0,12,0,0" Padding="0,8" HorizontalAlignment="Stretch"
                    Click="OnGenerateRelief" IsEnabled="False" />
            <!-- MOD22, after PhotoBoost's first-use blocks (PB58): what the first use downloads, how
                 large, its progress, and Pause, Resume or Try again. -->
            <Border x:Name="ReliefFirstUse" AutomationProperties.AutomationId="ReliefFirstUse" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ReliefFirstUseBadge" AutomationProperties.AutomationId="ReliefFirstUseBadge" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ReliefFirstUseDetail" AutomationProperties.AutomationId="ReliefFirstUseDetail" Style="{StaticResource StatCaption}" Margin="0,4,0,0" />
                <ProgressBar x:Name="ReliefFirstUseProgress" AutomationProperties.AutomationId="ReliefFirstUseProgress" Height="4" Maximum="100" Margin="0,2,0,6" Visibility="Collapsed" />
                <Button x:Name="ReliefFirstUseAction" AutomationProperties.AutomationId="ReliefFirstUseAction" HorizontalAlignment="Left" Padding="12,2"
                        Visibility="Collapsed" Click="OnFirstUseAction" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- MOD37: image or text to 3D through a cloud service, shown only once one holds a key.
             The options are the ones every such service shares; each provider maps them to its own
             API and prices them, so the button carries the estimate before anything is sent. -->
        <Border x:Name="CloudCard" AutomationProperties.AutomationId="CloudCard" Style="{StaticResource GroupCard}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="{x:Static p:Strings.CloudCardTitle}" Style="{StaticResource SectionHeader}" />
            <TextBlock Style="{StaticResource StatCaption}"
                       Text="{x:Static p:Strings.CloudCardCaption}" />
            <TextBlock Text="{x:Static p:Strings.CloudServiceLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CloudService" AutomationProperties.AutomationId="CloudService" AutomationProperties.Name="Service"
                      DisplayMemberPath="DisplayName" SelectionChanged="OnCloudOptionChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <RadioButton x:Name="CloudFromPhoto" AutomationProperties.AutomationId="CloudFromPhoto" GroupName="CloudSource"
                           Content="{x:Static p:Strings.CloudFromPhoto}" IsChecked="True" Checked="OnCloudOptionChanged" />
              <RadioButton x:Name="CloudFromText" AutomationProperties.AutomationId="CloudFromText" GroupName="CloudSource"
                           Content="{x:Static p:Strings.CloudFromText}" Margin="12,0,0,0" Checked="OnCloudOptionChanged" />
            </StackPanel>
            <TextBox x:Name="CloudPrompt" AutomationProperties.AutomationId="CloudPrompt" AutomationProperties.Name="Description"
                     Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" MaxLength="800" TextChanged="OnCloudPromptChanged" />
            <CheckBox x:Name="CloudTexture" AutomationProperties.AutomationId="CloudTexture" Content="{x:Static p:Strings.CloudTexture}" IsChecked="True" Margin="0,8,0,0"
                      Checked="OnCloudOptionChanged" Unchecked="OnCloudOptionChanged" ToolTip="{x:Static p:Strings.CloudTextureTip}" />
            <CheckBox x:Name="CloudPbr" AutomationProperties.AutomationId="CloudPbr" Content="{x:Static p:Strings.CloudPbr}" Margin="0,4,0,0"
                      Checked="OnCloudOptionChanged" Unchecked="OnCloudOptionChanged" />
            <CheckBox x:Name="CloudQuads" AutomationProperties.AutomationId="CloudQuads" Content="{x:Static p:Strings.QuadTopology}" Margin="0,4,0,0"
                      Checked="OnCloudOptionChanged" Unchecked="OnCloudOptionChanged" ToolTip="{x:Static p:Strings.CloudQuadsTip}" />
            <Button x:Name="CloudGenerate" AutomationProperties.AutomationId="CloudGenerate" Margin="0,12,0,0" Padding="0,8" HorizontalAlignment="Stretch"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnCloudGenerate" />
            <!-- Nothing leaves the PC before this is agreed to, each time. -->
            <Border x:Name="CloudConsent" AutomationProperties.AutomationId="CloudConsent" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="CloudConsentText" AutomationProperties.AutomationId="CloudConsentText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="CloudConsentSend" AutomationProperties.AutomationId="CloudConsentSend" Content="{x:Static p:Strings.SendIt}" Padding="12,2" Click="OnCloudSend" />
                  <Button x:Name="CloudConsentCancel" AutomationProperties.AutomationId="CloudConsentCancel" Content="{x:Static p:Strings.NotNow}" Padding="12,2" Margin="8,0,0,0"
                          Click="OnCloudNotNow" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource GroupCard}">
          <StackPanel>
            <TextBlock Text="{x:Static p:Strings.EditCardTitle}" Style="{StaticResource SectionHeader}" />
            <TextBlock Style="{StaticResource StatCaption}"
                       Text="{x:Static p:Strings.EditCardCaption}" />
            <TextBlock x:Name="SimplifyText" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="SimplifyAmount" AutomationProperties.AutomationId="SimplifyAmount" Minimum="0.02" Maximum="0.9" Value="0.25" ValueChanged="OnSimplifyAmountChanged"
                    ToolTip="{x:Static p:Strings.SimplifyAmountTip}" />
            <UniformGrid Columns="3" Margin="0,6,0,0">
              <Button x:Name="SimplifyButton" AutomationProperties.AutomationId="SimplifyButton" Content="{x:Static p:Strings.SimplifyButton}" Margin="0,0,4,4" Click="OnSimplify" IsEnabled="False" />
              <Button x:Name="SubdivideButton" AutomationProperties.AutomationId="SubdivideButton" Content="{x:Static p:Strings.SubdivideButton}" Margin="2,0,2,4" Click="OnSubdivide" IsEnabled="False"
                      ToolTip="{x:Static p:Strings.SubdivideButtonTip}" />
              <Button x:Name="FillHolesButton" AutomationProperties.AutomationId="FillHolesButton" Content="{x:Static p:Strings.FillHolesButton}" Margin="4,0,0,4" Click="OnFillHoles" IsEnabled="False"
                      ToolTip="{x:Static p:Strings.FillHolesButtonTip}" />
            </UniformGrid>
            <!-- MOD16: the amounts the CLI's -\-smooth, -\-remove-pieces and -\-flatten take, each beside its
                 button, in whole steps so the window passes the CLI's exact values. -->
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditAmountButton" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="64" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Button x:Name="PiecesButton" AutomationProperties.AutomationId="PiecesButton" Content="{x:Static p:Strings.PiecesButton}" Margin="0,0,8,4" Click="OnRemovePieces" IsEnabled="False"
                      ToolTip="{x:Static p:Strings.PiecesButtonTip}" />
              <Slider x:Name="PiecesAmount" Grid.Column="1" AutomationProperties.AutomationId="PiecesAmount" AutomationProperties.Name="Loose pieces under"
                      Minimum="1" Maximum="50" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                      VerticalAlignment="Center" ValueChanged="OnEditAmountChanged" />
              <TextBlock x:Name="PiecesText" Grid.Column="2" AutomationProperties.AutomationId="PiecesText" Text="{x:Static p:Strings.PiecesText}" VerticalAlignment="Center" Margin="8,0,0,0" />

              <Button x:Name="SmoothButton" Grid.Row="1" AutomationProperties.AutomationId="SmoothButton" Content="{x:Static p:Strings.SmoothButton}" Margin="0,0,8,4" Click="OnSmooth" IsEnabled="False"
                      ToolTip="{x:Static p:Strings.SmoothButtonTip}" />
              <Slider x:Name="SmoothAmount" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="SmoothAmount" AutomationProperties.Name="Smoothing passes"
                      Minimum="1" Maximum="10" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="2"
                      VerticalAlignment="Center" ValueChanged="OnEditAmountChanged" />
              <TextBlock x:Name="SmoothText" Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="SmoothText" Text="{x:Static p:Strings.SmoothText}" VerticalAlignment="Center" Margin="8,0,0,0" />

              <Button x:Name="FlattenButton" Grid.Row="2" AutomationProperties.AutomationId="FlattenButton" Content="{x:Static p:Strings.FlattenButton}" Margin="0,0,8,4" Click="OnFlatten" IsEnabled="False"
                      ToolTip="{x:Static p:Strings.FlattenButtonTip}" />
              <Slider x:Name="FlattenAmount" Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="FlattenAmount" AutomationProperties.Name="Flat base height"
                      Minimum="1" Maximum="20" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                      VerticalAlignment="Center" ValueChanged="OnEditAmountChanged" />
              <TextBlock x:Name="FlattenText" Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="FlattenText" Text="3%" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{x:Static p:Strings.WithAI}" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
            <Button x:Name="UpscaleTextureButton" AutomationProperties.AutomationId="UpscaleTextureButton" Content="{x:Static p:Strings.UpscaleTextureButton}" Margin="0,0,0,4" Click="OnUpscaleTexture" IsEnabled="False"
                    ToolTip="{x:Static p:Strings.UpscaleTextureButtonTip}" />
            <!-- MOD22, after PhotoBoost's first-use blocks (PB58): what the first use downloads, how
                 large, its progress, and Pause, Resume or Try again. -->
            <Border x:Name="TextureFirstUse" AutomationProperties.AutomationId="TextureFirstUse" Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="TextureFirstUseBadge" AutomationProperties.AutomationId="TextureFirstUseBadge" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TextureFirstUseDetail" AutomationProperties.AutomationId="TextureFirstUseDetail" Style="{StaticResource StatCaption}" Margin="0,4,0,0" />
                <ProgressBar x:Name="TextureFirstUseProgress" AutomationProperties.AutomationId="TextureFirstUseProgress" Height="4" Maximum="100" Margin="0,2,0,6" Visibility="Collapsed" />
                <Button x:Name="TextureFirstUseAction" AutomationProperties.AutomationId="TextureFirstUseAction" HorizontalAlignment="Left" Padding="12,2"
                        Visibility="Collapsed" Click="OnFirstUseAction" />
              </StackPanel>
            </Border>
            <!-- MOD40: a material drawn from a description by the image service holding a key, made
                 to tile and put on the model as a new version, so Undo returns to the old surface. -->
            <Button x:Name="NewTextureButton" AutomationProperties.AutomationId="NewTextureButton" Margin="0,0,0,4" Click="OnNewTexture" Visibility="Collapsed"
                    ToolTip="{x:Static p:Strings.NewTextureButtonTip}" />
            <Border x:Name="NewTexturePanel" AutomationProperties.AutomationId="NewTexturePanel" Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="{x:Static p:Strings.Material}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="NewTexturePrompt" AutomationProperties.AutomationId="NewTexturePrompt" AutomationProperties.Name="Material"
                         TextChanged="OnNewTextureChanged" ToolTip="{x:Static p:Strings.NewTexturePromptTip}" />
                <TextBlock x:Name="NewTextureAsked" AutomationProperties.AutomationId="NewTextureAsked" Style="{StaticResource StatCaption}" Margin="0,4,0,6" TextWrapping="Wrap" />
                <Button x:Name="NewTextureRun" AutomationProperties.AutomationId="NewTextureRun" Click="OnNewTextureRun" IsEnabled="False" />
                <Border x:Name="NewTextureConsent" AutomationProperties.AutomationId="NewTextureConsent" Margin="0,8,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock x:Name="NewTextureConsentText" AutomationProperties.AutomationId="NewTextureConsentText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <Button x:Name="NewTextureSend" AutomationProperties.AutomationId="NewTextureSend" Content="{x:Static p:Strings.SendIt}" Padding="12,2" Click="OnNewTextureSend" />
                      <Button x:Name="NewTextureNotNow" AutomationProperties.AutomationId="NewTextureNotNow" Content="{x:Static p:Strings.NotNow}" Padding="12,2" Margin="8,0,0,0" Click="OnNewTextureNotNow" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="NewTextureStatus" AutomationProperties.AutomationId="NewTextureStatus" Style="{StaticResource StatCaption}" Margin="0,6,0,4" TextWrapping="Wrap" />
                <WrapPanel x:Name="NewTextureCandidates" AutomationProperties.AutomationId="NewTextureCandidates" />
              </StackPanel>
            </Border>
            <Button x:Name="ReprojectButton" AutomationProperties.AutomationId="ReprojectButton" Content="{x:Static p:Strings.ReprojectButton}" Click="OnReproject" IsEnabled="False"
                    ToolTip="{x:Static p:Strings.ReprojectButtonTip}" />
            <!-- MOD38: the open model remeshed or retextured by a cloud service holding a key, as a
                 new version, so Undo returns to the local one. What goes, and for how much, is
                 said first. -->
            <StackPanel x:Name="CloudEditGroup" Visibility="Collapsed">
              <TextBlock x:Name="CloudEditTitle" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
              <DockPanel>
                <TextBlock Text="{x:Static p:Strings.Triangles}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox x:Name="CloudRemeshPolycount" AutomationProperties.AutomationId="CloudRemeshPolycount" AutomationProperties.Name="Remesh to"
                         Text="30000" TextChanged="OnCloudEditChanged" ToolTip="{x:Static p:Strings.CloudRemeshPolycountTip}" />
              </DockPanel>
              <CheckBox x:Name="CloudRemeshQuads" AutomationProperties.AutomationId="CloudRemeshQuads" Content="{x:Static p:Strings.QuadTopology}" Margin="0,4,0,0" />
              <Button x:Name="CloudRemesh" AutomationProperties.AutomationId="CloudRemesh" Margin="0,6,0,0" Click="OnCloudRemesh" />
              <TextBox x:Name="CloudRetexturePrompt" AutomationProperties.AutomationId="CloudRetexturePrompt" AutomationProperties.Name="New texture"
                       Margin="0,10,0,0" MaxLength="800" TextWrapping="Wrap" TextChanged="OnCloudEditChanged"
                       ToolTip="{x:Static p:Strings.CloudRetexturePromptTip}" />
              <CheckBox x:Name="CloudKeepUv" AutomationProperties.AutomationId="CloudKeepUv" Content="{x:Static p:Strings.CloudKeepUv}" Margin="0,4,0,0" />
              <Button x:Name="CloudRetexture" AutomationProperties.AutomationId="CloudRetexture" Margin="0,6,0,0" Click="OnCloudRetexture" />
              <Border x:Name="CloudEditConsent" AutomationProperties.AutomationId="CloudEditConsent" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="CloudEditConsentText" AutomationProperties.AutomationId="CloudEditConsentText" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="CloudEditSend" AutomationProperties.AutomationId="CloudEditSend" Content="{x:Static p:Strings.SendIt}" Padding="12,2" Click="OnCloudEditSend" />
                    <Button x:Name="CloudEditCancel" AutomationProperties.AutomationId="CloudEditCancel" Content="{x:Static p:Strings.NotNow}" Padding="12,2" Margin="8,0,0,0"
                            Click="OnCloudEditNotNow" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- MOD13, after PhotoBoost's Export card (PB25): the format and only the options it has,
             what the model will lose in it, then Save as, which the toolbar's button shares. -->
        <Border x:Name="ExportCard" Style="{StaticResource GroupCard}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="{x:Static p:Strings.ExportCardTitle}" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="{x:Static p:Strings.ExportFormatLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ExportFormat" AutomationProperties.AutomationId="ExportFormat" AutomationProperties.Name="Format"
                      SelectedIndex="0" SelectionChanged="OnExportFormatChanged">
              <ComboBoxItem Content="{x:Static p:Strings.ExportFormatGlb}" Tag="glb" />
              <ComboBoxItem Content="{x:Static p:Strings.ExportFormatObj}" Tag="obj" />
              <ComboBoxItem Content="{x:Static p:Strings.ExportFormatPly}" Tag="ply" />
              <ComboBoxItem Content="{x:Static p:Strings.ExportFormatStl}" Tag="stl" />
            </ComboBox>
            <StackPanel x:Name="ExportObjOptions" Visibility="Collapsed" Margin="0,8,0,0">
              <RadioButton x:Name="ExportObjTexture" AutomationProperties.AutomationId="ExportObjTexture" GroupName="ObjColours"
                           Content="{x:Static p:Strings.ExportObjTexture}" IsChecked="True" Checked="OnExportOptionChanged" />
              <RadioButton x:Name="ExportObjVertexColours" AutomationProperties.AutomationId="ExportObjVertexColours" GroupName="ObjColours"
                           Content="{x:Static p:Strings.ExportObjVertexColours}" Margin="0,4,0,0" Checked="OnExportOptionChanged" />
            </StackPanel>
            <!-- MOD66: quantized geometry, about half the bytes, for viewers that read KHR_mesh_quantization. -->
            <StackPanel x:Name="ExportGlbOptions" Visibility="Collapsed" Margin="0,8,0,0">
              <RadioButton x:Name="ExportGlbStandard" AutomationProperties.AutomationId="ExportGlbStandard" GroupName="GlbGeometry"
                           Content="{x:Static p:Strings.ExportGlbStandard}" IsChecked="True" />
              <RadioButton x:Name="ExportGlbCompact" AutomationProperties.AutomationId="ExportGlbCompact" GroupName="GlbGeometry"
                           Content="{x:Static p:Strings.ExportGlbCompact}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel x:Name="ExportPlyOptions" Visibility="Collapsed" Margin="0,8,0,0">
              <RadioButton x:Name="ExportPlyBinary" AutomationProperties.AutomationId="ExportPlyBinary" GroupName="PlyEncoding"
                           Content="{x:Static p:Strings.ExportPlyBinary}" IsChecked="True" />
              <RadioButton x:Name="ExportPlyAscii" AutomationProperties.AutomationId="ExportPlyAscii" GroupName="PlyEncoding"
                           Content="{x:Static p:Strings.ExportPlyAscii}" Margin="0,4,0,0" />
            </StackPanel>
            <!-- MOD15: the size the CLI's -\-size takes, in the format's unit, and the box it gives. -->
            <TextBlock Text="{x:Static p:Strings.LongestSide}" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
            <DockPanel>
              <TextBlock x:Name="ExportSizeUnit" AutomationProperties.AutomationId="ExportSizeUnit" DockPanel.Dock="Right"
                         VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" />
              <TextBox x:Name="ExportSize" AutomationProperties.AutomationId="ExportSize" AutomationProperties.Name="Longest side"
                       Text="1" TextChanged="OnExportSizeChanged" />
            </DockPanel>
            <TextBlock x:Name="ExportDimensions" AutomationProperties.AutomationId="ExportDimensions" Style="{StaticResource StatCaption}" Margin="0,4,0,0" />
            <TextBlock x:Name="ExportNote" AutomationProperties.AutomationId="ExportNote" Style="{StaticResource StatCaption}"
                       Margin="0,8,0,0" Visibility="Collapsed" />
            <Button x:Name="ExportSaveAs" AutomationProperties.AutomationId="ExportSaveAs" Content="{x:Static p:Strings.ExportSaveAs}" Command="SaveAs"
                    Margin="0,10,0,0" Padding="0,6" HorizontalAlignment="Stretch" />
            <!-- MOD46: shown only where Blender is found. -->
            <Button x:Name="OpenInBlender" AutomationProperties.AutomationId="OpenInBlender" Content="{x:Static p:Strings.OpenInBlender}"
                    Margin="0,6,0,0" Padding="0,6" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnOpenInBlender"
                    ToolTip="{x:Static p:Strings.OpenInBlenderTip}" />
            <TextBlock x:Name="ExportStatus" AutomationProperties.AutomationId="ExportStatus" Style="{StaticResource StatCaption}"
                       Margin="0,8,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <!-- MOD12, after PhotoBoost's History card (PB28): every version the model went through, the
             one shown selected, so how far Undo goes is seen before it is pressed. Read, not clicked. -->
        <Border x:Name="HistoryCard" Style="{StaticResource GroupCard}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="{x:Static p:Strings.HistoryCardTitle}" Style="{StaticResource SectionHeader}" />
            <ListBox x:Name="HistoryList" AutomationProperties.AutomationId="History" AutomationProperties.Name="History"
                     MaxHeight="160" IsHitTestVisible="False" Focusable="False" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource GroupCard}">
          <StackPanel>
            <TextBlock Text="{x:Static p:Strings.QualityCardTitle}" Style="{StaticResource SectionHeader}" />
            <RadioButton x:Name="QualityStandard" AutomationProperties.AutomationId="QualityStandard" Content="{x:Static p:Strings.QualityStandard}" IsChecked="True" Checked="OnQualityChanged" />
            <RadioButton x:Name="QualityHigh" AutomationProperties.AutomationId="QualityHigh" Content="{x:Static p:Strings.QualityHigh}" Margin="0,4,0,0" Checked="OnQualityChanged" />
            <TextBlock Style="{StaticResource StatCaption}" Margin="0,8,0,0"
                       Text="{x:Static p:Strings.QualityCaption}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
    </DockPanel>

    <!-- MOD11: About, after PhotoBoost's AboutPanel (PB46). It takes the stage's place while open,
         so the toolbar and the status bar, a running download's chip included, stay in view. -->
    <ScrollViewer x:Name="AboutPanel" AutomationProperties.AutomationId="AboutPanel" Grid.Row="1" Grid.ColumnSpan="2"
                  Margin="12,0,12,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <Border Style="{StaticResource GroupCard}" Padding="24" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <Button x:Name="AboutClose" AutomationProperties.AutomationId="AboutClose" DockPanel.Dock="Right"
                    Content="{x:Static p:Strings.AboutClose}" Padding="12,4" Click="OnAbout" />
            <TextBlock Text="{x:Static p:Strings.AppName}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="AboutVersion" AutomationProperties.AutomationId="AboutVersion" Style="{StaticResource StatCaption}" />
          <TextBlock x:Name="AboutInference" AutomationProperties.AutomationId="AboutInference" Style="{StaticResource StatCaption}" Margin="0,2,0,16" />

          <!-- MOD30: whether a newer release exists, asked of GitHub's release API. -->
          <TextBlock x:Name="AboutUpdatesHeader" Text="{x:Static p:Strings.UpdatesTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock x:Name="AboutUpdateStatus" AutomationProperties.AutomationId="AboutUpdateStatus" Style="{StaticResource StatCaption}" Margin="0,0,0,6" />
          <WrapPanel>
            <Button x:Name="AboutCheckUpdates" AutomationProperties.AutomationId="AboutCheckUpdates" Content="{x:Static p:Strings.AboutCheckUpdates}"
                    Padding="12,4" Margin="0,0,8,6" Click="OnCheckForUpdates" />
            <Button x:Name="AboutReleasePage" AutomationProperties.AutomationId="AboutReleasePage" Content="{x:Static p:Strings.AboutReleasePage}"
                    Padding="12,4" Margin="0,0,8,6" Click="OnOpenReleasePage" Visibility="Collapsed" />
            <!-- MOD31: downloads the installer, checks it against SHA256SUMS, runs it and restarts. -->
            <Button x:Name="AboutInstallUpdate" AutomationProperties.AutomationId="AboutInstallUpdate" Content="{x:Static p:Strings.AboutInstallUpdate}"
                    Padding="12,4" Margin="0,0,8,6" Click="OnInstallUpdate" Visibility="Collapsed"
                    Style="{DynamicResource AccentButtonStyle}" />
          </WrapPanel>
          <!-- An unsaved model is lost on restart, so the update asks here first, not in a dialog. -->
          <Border x:Name="AboutUpdateConfirm" AutomationProperties.AutomationId="AboutUpdateConfirm" Padding="12,10" Margin="0,0,0,10" CornerRadius="6"
                  Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="AboutUpdateUnsaved" AutomationProperties.AutomationId="AboutUpdateUnsaved" TextWrapping="Wrap"
                         Text="{x:Static p:Strings.AboutUpdateUnsaved}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AboutUpdateAnyway" AutomationProperties.AutomationId="AboutUpdateAnyway" Content="{x:Static p:Strings.AboutUpdateAnyway}" Padding="12,2"
                        Click="OnUpdateAnyway" />
                <Button x:Name="AboutUpdateKeep" AutomationProperties.AutomationId="AboutUpdateKeep" Content="{x:Static p:Strings.AboutUpdateKeep}" Padding="12,2" Margin="8,0,0,0"
                        Click="OnUpdateKeep" />
              </StackPanel>
            </StackPanel>
          </Border>
          <CheckBox x:Name="AboutAutoUpdate" AutomationProperties.AutomationId="AboutAutoUpdate" Content="{x:Static p:Strings.AboutAutoUpdate}"
                    Margin="0,0,0,16" Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged"
                    ToolTip="{x:Static p:Strings.AboutAutoUpdateTip}" />

          <!-- MOD37: one row per cloud service the build knows, filled in code from
               CloudProviders, so a new service is a class behind the provider interface and no new
               screen. A key is kept encrypted for this Windows user; nothing reaches a service
               without one. -->
          <TextBlock Text="{x:Static p:Strings.CloudServices}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock Style="{StaticResource StatCaption}" Margin="0,0,0,6" TextWrapping="Wrap"
                     Text="{x:Static p:Strings.CloudServicesCaption}" />
          <StackPanel x:Name="AboutCloudServices" AutomationProperties.AutomationId="AboutCloudServices" Margin="0,0,0,16" />

          <!-- MOD18: what the provider flag sets, chosen here, saved per user and applied to the next operation. -->
          <TextBlock Text="{x:Static p:Strings.WhereInferenceRuns}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <RadioButton x:Name="ProviderAuto" AutomationProperties.AutomationId="ProviderAuto" GroupName="Provider" Checked="OnProviderChanged"
                       Content="{x:Static p:Strings.ProviderAuto}" />
          <RadioButton x:Name="ProviderDirectML" AutomationProperties.AutomationId="ProviderDirectML" GroupName="Provider" Checked="OnProviderChanged"
                       Content="{x:Static p:Strings.ProviderDirectML}" Margin="0,4,0,0" />
          <RadioButton x:Name="ProviderCpu" AutomationProperties.AutomationId="ProviderCpu" GroupName="Provider" Checked="OnProviderChanged"
                       Content="{x:Static p:Strings.ProviderCpu}" Margin="0,4,0,0"
                       ToolTip="{x:Static p:Strings.ProviderCpuTip}" />
          <TextBlock x:Name="AboutProviderReason" AutomationProperties.AutomationId="AboutProviderReason" Style="{StaticResource StatCaption}" Margin="0,6,0,0" />
          <TextBlock Style="{StaticResource StatCaption}" Margin="0,2,0,16"
                     Text="{x:Static p:Strings.ProviderCaption}" />

          <TextBlock Text="{x:Static p:Strings.ModelsTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock x:Name="AboutModelsFolder" AutomationProperties.AutomationId="AboutModelsFolder" Style="{StaticResource StatCaption}" Margin="0,0,0,6" />
          <ListBox x:Name="AboutModels" AutomationProperties.AutomationId="AboutModels" AutomationProperties.Name="Models"
                   IsHitTestVisible="False" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="AboutManifest" AutomationProperties.AutomationId="AboutManifest" Style="{StaticResource StatCaption}" Margin="0,6,0,16" />

          <!-- MOD27: repositories read after the built-in one, kept per user. Adding one shows what it
               lists before it is kept, here and not in a dialog. -->
          <TextBlock Text="{x:Static p:Strings.ModelSources}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock Style="{StaticResource StatCaption}" Margin="0,0,0,6" TextWrapping="Wrap"
                     Text="{x:Static p:Strings.ModelSourcesCaption}" />
          <ItemsControl x:Name="AboutSources" AutomationProperties.AutomationId="AboutSources" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Remove}" Padding="10,2" Tag="{Binding Index}" Visibility="{Binding RemoveVisibility}"
                          AutomationProperties.AutomationId="{Binding RemoveId}" AutomationProperties.Name="{Binding RemoveName}"
                          Click="OnRemoveSource" />
                  <TextBlock Text="{Binding Label}" AutomationProperties.AutomationId="{Binding LabelId}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,0,0,6">
            <Button x:Name="AboutAddSource" AutomationProperties.AutomationId="AboutAddSource" DockPanel.Dock="Right" Content="{x:Static p:Strings.AboutAddSource}"
                    Padding="12,4" Margin="8,0,0,0" Click="OnAddSource" />
            <TextBox x:Name="AboutSourceInput" AutomationProperties.AutomationId="AboutSourceInput" AutomationProperties.Name="Repository or manifest URL"
                     ToolTip="{x:Static p:Strings.AboutSourceInputTip}" />
          </DockPanel>
          <Border x:Name="AboutSourcePreview" AutomationProperties.AutomationId="AboutSourcePreview" Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                  Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="AboutSourcePreviewTitle" AutomationProperties.AutomationId="AboutSourcePreviewTitle" TextWrapping="Wrap" FontWeight="SemiBold" />
              <ListBox x:Name="AboutSourcePreviewModels" AutomationProperties.AutomationId="AboutSourcePreviewModels" AutomationProperties.Name="What the source lists"
                       IsHitTestVisible="False" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AboutSourceKeep" AutomationProperties.AutomationId="AboutSourceKeep" Content="{x:Static p:Strings.AboutSourceKeep}" Padding="12,2"
                        Click="OnKeepSource" />
                <Button x:Name="AboutSourceCancel" AutomationProperties.AutomationId="AboutSourceCancel" Content="{x:Static p:Strings.Cancel}" Padding="12,2" Margin="8,0,0,0"
                        Click="OnCancelSource" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="AboutSourceNote" AutomationProperties.AutomationId="AboutSourceNote" Style="{StaticResource StatCaption}" TextWrapping="Wrap"
                     Margin="0,0,0,6" Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
          <Border Height="10" />

          <TextBlock Text="{x:Static p:Strings.DownloadsTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock x:Name="AboutDownloadNote" AutomationProperties.AutomationId="AboutDownloadNote" Style="{StaticResource StatCaption}" Margin="0,0,0,6" />
          <!-- MOD23, after PhotoBoost's DownloadedModels (PB13, PB58): each download, its size, and a
               Remove of its own whose AutomationId names the model. -->
          <ItemsControl x:Name="AboutDownloadedModels" AutomationProperties.AutomationId="AboutDownloadedModels" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Remove}" Padding="10,2" Tag="{Binding Name}"
                          AutomationProperties.AutomationId="{Binding RemoveId}" AutomationProperties.Name="{Binding RemoveName}"
                          Click="OnAboutRemoveModel" />
                  <TextBlock Text="{Binding Label}" AutomationProperties.AutomationId="{Binding LabelId}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="AboutRemoveNote" AutomationProperties.AutomationId="AboutRemoveNote" Style="{StaticResource StatCaption}"
                     Margin="0,0,0,6" Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
          <WrapPanel Margin="0,0,0,6">
            <Button x:Name="AboutDownloadAll" AutomationProperties.AutomationId="AboutDownloadAll" Content="{x:Static p:Strings.AboutDownloadAll}"
                    Padding="12,4" Margin="0,0,8,6" Click="OnAboutDownloadAll" />
            <Button x:Name="AboutOpenFolder" AutomationProperties.AutomationId="AboutOpenFolder" Content="{x:Static p:Strings.AboutOpenFolder}"
                    Padding="12,4" Margin="0,0,8,6" Click="OnAboutOpenFolder" />
            <Button x:Name="AboutRemoveAll" AutomationProperties.AutomationId="AboutRemoveAll" Content="{x:Static p:Strings.AboutRemoveAll}"
                    Padding="12,4" Margin="0,0,8,6" Click="OnAboutRemoveAll" />
          </WrapPanel>
          <!-- Remove all asks here, in the panel, not in a dialog. -->
          <Border x:Name="AboutRemoveAllConfirm" AutomationProperties.AutomationId="AboutRemoveAllConfirm" Padding="12,10" Margin="0,0,0,10" CornerRadius="6"
                  Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="AboutRemoveAllQuestion" AutomationProperties.AutomationId="AboutRemoveAllQuestion" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AboutRemoveAllDelete" AutomationProperties.AutomationId="AboutRemoveAllDelete" Content="{x:Static p:Strings.AboutRemoveAllDelete}" Padding="12,2"
                        Click="OnAboutRemoveAllDelete" />
                <Button x:Name="AboutRemoveAllKeep" AutomationProperties.AutomationId="AboutRemoveAllKeep" Content="{x:Static p:Strings.AboutRemoveAllKeep}" Padding="12,2" Margin="8,0,0,0"
                        Click="OnAboutRemoveAllKeep" />
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- A download in progress, the same one the job panel and the status bar show. -->
          <StackPanel Visibility="{Binding Visibility, ElementName=DownloadChip}" Margin="0,0,0,16">
            <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Value, ElementName=ProgressBar}" Margin="0,0,0,6" />
            <DockPanel>
              <Button x:Name="AboutCancelDownload" AutomationProperties.AutomationId="AboutCancelDownload" DockPanel.Dock="Right"
                      Content="{x:Static p:Strings.Cancel}" Padding="12,2" Click="OnAboutCancelDownload" />
              <TextBlock x:Name="AboutDownloadStatus" AutomationProperties.AutomationId="AboutDownloadStatus" Style="{StaticResource StatCaption}"
                         VerticalAlignment="Center" Margin="0" Text="{Binding Text, ElementName=DownloadChipText}" />
            </DockPanel>
          </StackPanel>

          <TextBlock Text="{x:Static p:Strings.ThirdPartySoftware}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock x:Name="AboutNotices" AutomationProperties.AutomationId="AboutNotices" Style="{StaticResource StatCaption}"
                     Text="{x:Static p:Strings.AboutNotices}" />
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- MOD21, after PhotoBoost's ConsentPanel (PB58): before a first-use download, everything a
         person needs to say yes: what is downloaded and how large, from where, where it goes, that
         the photo stays here, and the license. It takes the stage's place, as About does. -->
    <ScrollViewer x:Name="ConsentPanel" AutomationProperties.AutomationId="ConsentPanel" Grid.Row="1" Grid.ColumnSpan="2"
                  Margin="12,0,12,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <Border Style="{StaticResource GroupCard}" Padding="24" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="ConsentTitle" AutomationProperties.AutomationId="ConsentTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="ConsentLead" AutomationProperties.AutomationId="ConsentLead" TextWrapping="Wrap" Margin="0,8,0,16" />

          <TextBlock Text="{x:Static p:Strings.WhatIsDownloaded}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <ListBox x:Name="ConsentFiles" AutomationProperties.AutomationId="ConsentFiles" AutomationProperties.Name="What is downloaded"
                   IsHitTestVisible="False" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ConsentTotal" AutomationProperties.AutomationId="ConsentTotal" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,16" />

          <TextBlock Text="{x:Static p:Strings.GoodToKnow}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock x:Name="ConsentFacts" AutomationProperties.AutomationId="ConsentFacts" Style="{StaticResource StatCaption}" Margin="0,0,0,16" />

          <TextBlock Text="{x:Static p:Strings.LicenseTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <TextBlock x:Name="ConsentLicense" AutomationProperties.AutomationId="ConsentLicense" Style="{StaticResource StatCaption}" />

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="ConsentAccept" AutomationProperties.AutomationId="ConsentAccept" Padding="16,6" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnConsentAccept" />
            <Button x:Name="ConsentDecline" AutomationProperties.AutomationId="ConsentDecline" Content="{x:Static p:Strings.NotNow}" Padding="16,6" Margin="8,0,0,0"
                    IsCancel="True" Click="OnConsentDecline" />
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- MOD9: the status bar, after PhotoBoost's (PB14, PB24, PB58, PB60): chips that carry a
         word each, seen wherever the cards have scrolled to. Left to right: where inference runs;
         what is open; the mesh; the run in progress, bound to the job panel; a model download in
         progress; and what the last run, edit, save or download came to. About sits on the right. -->
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="12,6,12,8" LastChildFill="True">
      <Button x:Name="AboutButton" AutomationProperties.AutomationId="AboutButton" DockPanel.Dock="Right"
              Content="{x:Static p:Strings.AboutButton}" Padding="10,2" Margin="6,0,0,0" Click="OnAbout" />
      <!-- MOD55: once a cloud key is stored, the service closest to its budget and what it has cost
           this month; it says when a budget is nearly spent, and opens About at Cloud services. -->
      <Button x:Name="CloudChip" AutomationProperties.AutomationId="CloudChip" DockPanel.Dock="Right"
              Padding="10,2" Margin="6,0,0,0" Click="OnCloudChip" Visibility="Collapsed"
              ToolTip="{x:Static p:Strings.CloudChipTip}" />
      <!-- MOD30: a newer release, found by the check; it opens About at its Updates section. -->
      <Button x:Name="UpdateChip" AutomationProperties.AutomationId="UpdateChip" DockPanel.Dock="Right"
              Padding="10,2" Margin="6,0,0,0" Click="OnUpdateChip" Visibility="Collapsed"
              Style="{DynamicResource AccentButtonStyle}" ToolTip="{x:Static p:Strings.UpdateChipTip}" />
      <Border x:Name="ProviderChip" Style="{StaticResource StatusChip}" DockPanel.Dock="Left">
        <TextBlock x:Name="ProviderStatus" AutomationProperties.AutomationId="ProviderStatus" FontSize="12" Text="…" />
      </Border>
      <Border x:Name="SourceChip" Style="{StaticResource StatusChip}" DockPanel.Dock="Left" Visibility="Collapsed">
        <TextBlock x:Name="SourceText" AutomationProperties.AutomationId="SourceText" FontSize="12" />
      </Border>
      <Border x:Name="MeshChip" Style="{StaticResource StatusChip}" DockPanel.Dock="Left" Visibility="Collapsed">
        <TextBlock x:Name="MeshText" AutomationProperties.AutomationId="MeshText" FontSize="12" />
      </Border>
      <Border x:Name="JobChip" Style="{StaticResource StatusChip}" DockPanel.Dock="Left" Visibility="Collapsed">
        <TextBlock x:Name="JobChipText" AutomationProperties.AutomationId="JobChip" FontSize="12">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0}: {1}">
              <Binding ElementName="ProgressTitle" Path="Text" />
              <Binding ElementName="ProgressText" Path="Text" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </Border>
      <Border x:Name="DownloadChip" Style="{StaticResource StatusChip}" DockPanel.Dock="Left" Visibility="Collapsed">
        <!-- Set in code, by whichever download is running: a card's first use or About's (MOD22). -->
        <TextBlock x:Name="DownloadChipText" AutomationProperties.AutomationId="DownloadChip" FontSize="12" />
      </Border>
      <Border x:Name="LastRunChip" Style="{StaticResource StatusChip}" HorizontalAlignment="Left" Visibility="Collapsed">
        <TextBlock x:Name="LastRun" AutomationProperties.AutomationId="LastRun" FontSize="12" TextTrimming="CharacterEllipsis" />
      </Border>
    </DockPanel>
  </Grid>

  <!-- MOD5: Open, Undo and Redo bring their own Ctrl+O, Ctrl+Z and Ctrl+Y; Save as has no gesture
       of its own, so Ctrl+S is bound here, and Ctrl+Shift+Z is the other redo people reach for. -->
  <Window.InputBindings>
    <KeyBinding Command="SaveAs" Key="S" Modifiers="Ctrl" />
    <KeyBinding Command="Redo" Key="Z" Modifiers="Ctrl+Shift" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="Open" Executed="OnOpen" CanExecute="CanOpen" />
    <CommandBinding Command="SaveAs" Executed="OnExport" CanExecute="CanSave" />
    <CommandBinding Command="Undo" Executed="OnUndo" CanExecute="CanUndo" />
    <CommandBinding Command="Redo" Executed="OnRedo" CanExecute="CanRedo" />
    <CommandBinding Command="{x:Static local:MainWindow.RotateXCommand}" Executed="OnRotate" CanExecute="CanEdit" />
    <CommandBinding Command="{x:Static local:MainWindow.RotateYCommand}" Executed="OnRotate" CanExecute="CanEdit" />
    <CommandBinding Command="{x:Static local:MainWindow.RotateZCommand}" Executed="OnRotate" CanExecute="CanEdit" />
    <CommandBinding Command="{x:Static local:MainWindow.MirrorCommand}" Executed="OnMirror" CanExecute="CanEdit" />
    <CommandBinding Command="{x:Static local:MainWindow.ResetViewCommand}" Executed="OnResetView" CanExecute="CanResetView" />
    <CommandBinding Command="{x:Static local:MainWindow.SaveViewCommand}" Executed="OnSaveView" CanExecute="CanResetView" />
  </Window.CommandBindings>
</Window>
