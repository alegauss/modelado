<!-- The theme is set on each window from Theme.Mode (MOD4), never here: PhotoBoost's siblings
     measured the Application-wide ThemeMode rendering differently from a window's. It gives the
     Fluent styles in light or dark, and on Windows 11 the Mica backdrop. Styles.xaml holds the
     shared styles; the few brushes of Modelado's own colours are added from Brand at startup. -->
<Application x:Class="Modelado.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
